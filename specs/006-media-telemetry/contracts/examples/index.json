  "not_schema_checkable": [
    {
      "schema": "frame-manifest.schema.json",
      "class": "non-finite number",
      "by": "loader",
      "rule": "FR-001-05"
    },
    {
      "schema": "frame-manifest.schema.json",
      "class": "frame_sha256 length not equal to frames, or source_frames_sha256 not the digest of the ordered per-frame digests",
      "by": "checker",
      "rule": "FR-006-12"
    },
    {
      "schema": "frame-manifest.schema.json",
      "class": "frame file missing, truncated or undecodable, or differing from the declared size or bit depth",
      "by": "checker",
      "rule": "FR-006-12"
    },
    {
      "schema": "frame-manifest.schema.json",
      "class": "frame path resolving outside the input folder through a link",
      "by": "checker",
      "rule": "FR-006-13"
    },
    {
      "schema": "frame-manifest.schema.json",
      "class": "Windows device name as a directory segment",
      "by": "checker",
      "rule": "FR-006-13"
    },
    {
      "schema": "frame-manifest.schema.json",
      "class": "performance class not equal to the producer tool's registry entry",
      "by": "checker",
      "rule": "FR-006-14"
    },
    {
      "schema": "encode-report.schema.json",
      "class": "non-finite number",
      "by": "loader",
      "rule": "FR-001-05"
    },
    {
      "schema": "encode-report.schema.json",
      "class": "pair_bytes not equal to the sum of the two variants' bytes",
      "by": "checker",
      "rule": "FR-006-03"
    },
    {
      "schema": "encode-report.schema.json",
      "class": "chosen_cq not among the trials or outside cq_range, or cq_range min above max",
      "by": "checker",
      "rule": "FR-006-02"
    },
    {
      "schema": "encode-report.schema.json",
      "class": "chosen_cq not the largest tried value meeting both targets",
      "by": "checker",
      "rule": "FR-006-02"
    },
    {
      "schema": "encode-report.schema.json",
      "class": "re-measured VMAF below a lower-target relaxation",
      "by": "checker",
      "rule": "FR-006-04"
    },
    {
      "schema": "encode-report.schema.json",
      "class": "variant or poster bytes and sha256 not equal to the files",
      "by": "checker",
      "rule": "FR-006-05"
    },
    {
      "schema": "encode-report.schema.json",
      "class": "record frames, fps or source_frames_sha256 not equal to the clip and its frame manifest",
      "by": "checker",
      "rule": "FR-006-05"
    },
    {
      "schema": "encode-report.schema.json",
      "class": "record duration_s further than one frame period from frames / fps",
      "by": "checker",
      "rule": "FR-001-17"
    },
    {
      "schema": "encode-report.schema.json",
      "class": "absolute paths in the recorded encoder arguments",
      "by": "checker",
      "rule": "FR-006-06",
      "note": "privacy scan of FR-001-15"
    },
    {
      "schema": "encode-report.schema.json",
      "class": "two clips with the same name",
      "by": "checker",
      "rule": "FR-006-13"
    },
    {
      "schema": "profile-summary.schema.json",
      "class": "non-finite number",
      "by": "loader",
      "rule": "FR-001-05"
    },
    {
      "schema": "profile-summary.schema.json",
      "class": "kernel table file above 100,000 bytes",
      "by": "loader",
      "rule": "NFR-006-03"
    },
    {
      "schema": "profile-summary.schema.json",
      "class": "kernels not sorted by total_ms (largest first) or not the top min(20, kernels_total)",
      "by": "checker",
      "rule": "FR-006-20"
    },
    {
      "schema": "profile-summary.schema.json",
      "class": "mean_ms not equal to total_ms / calls",
      "by": "checker",
      "rule": "FR-006-20"
    },
    {
      "schema": "profile-summary.schema.json",
      "class": "two kernels with the same name",
      "by": "checker",
      "rule": "FR-006-20"
    },
    {
      "schema": "profile-summary.schema.json",
      "class": "trace bytes not equal to the file size, or truncated false while the trace reached the cap",
      "by": "checker",
      "rule": "FR-006-21"
    }
  ]
}

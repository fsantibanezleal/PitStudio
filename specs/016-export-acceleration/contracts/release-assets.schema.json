{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/release-assets.schema.json",
  "title": "Release-asset upload list",
  "description": "Release-asset upload list written by s60_export: tag and the release-hosted files with path, bytes and SHA-256, sorted by path (DC-016-02, spec 016-export-acceleration).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 200
    },
    "schema_version": {
      "$ref": "#/$defs/schema_version"
    },
    "tag": {
      "$ref": "#/$defs/release_tag"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      },
      "maxItems": 2000
    }
  },
  "required": [
    "schema_version",
    "tag",
    "entries"
  ],
  "$defs": {
    "release_tag": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^assets-v[0-9]+\\.[0-9]{2}\\.[0-9]{3}$"
    },
    "relpath": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?(/[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?){0,15}$"
    },
    "sha256": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_version": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^1\\.[0-9]+$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/relpath"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ]
    }
  }
}

  "not_schema_checkable": [
    {
      "schema": "fetch-record.schema.json",
      "class": "non-finite number, malformed JSON, BOM, duplicate key, byte cap",
      "by": "loader",
      "rule": "FR-008-17",
      "note": "loader: pitstudio.contracts.load_json / load_yaml (FR-001-05, FR-001-06)"
    },
    {
      "schema": "fetch-record.schema.json",
      "class": "credential-named query key or the account key value in any field",
      "by": "checker",
      "rule": "FR-008-13",
      "note": "the https_url pattern admits query strings; the key value is a sentinel search"
    },
    {
      "schema": "fetch-record.schema.json",
      "class": "sha256 or bytes of a verified record differ from expected_sha256 / expected_bytes",
      "by": "checker",
      "rule": "FR-008-06",
      "note": "arithmetic across fields"
    },
    {
      "schema": "fetch-record.schema.json",
      "class": "source, url, spdx, licence class or redistribution differ from data/sources.yaml; fallback ids absent from the registry",
      "by": "checker",
      "rule": "FR-008-17",
      "note": "another file"
    },
    {
      "schema": "fetch-record.schema.json",
      "class": "local name with a Windows device name, control character or more than 200 characters",
      "by": "checker",
      "rule": "FR-008-11",
      "note": "data-model 001 section 1.3 checker rules"
    },
    {
      "schema": "ingestion-report.schema.json",
      "class": "non-finite number, malformed JSON, BOM, duplicate key, byte cap",
      "by": "loader",
      "rule": "FR-008-21",
      "note": "loader: pitstudio.contracts.load_json / load_yaml (FR-001-05, FR-001-06)"
    },
    {
      "schema": "ingestion-report.schema.json",
      "class": "violation file absent from files; report status not rejected while a file is rejected",
      "by": "checker",
      "rule": "FR-008-21",
      "note": "ids that must exist elsewhere in the document"
    },
    {
      "schema": "ingestion-report.schema.json",
      "class": "violations not every failing cell of the frame (lazy validation incomplete)",
      "by": "checker",
      "rule": "FR-008-21",
      "note": "needs the input file"
    },
    {
      "schema": "split.schema.json",
      "class": "non-finite number, malformed JSON, BOM, duplicate key",
      "by": "loader",
      "rule": "FR-008-47",
      "note": "loader: pitstudio.contracts.load_json / load_yaml (FR-001-05, FR-001-06)"
    },
    {
      "schema": "split.schema.json",
      "class": "membership_sha256 differs from the lists",
      "by": "checker",
      "rule": "FR-008-47",
      "note": "payload digest"
    },
    {
      "schema": "split.schema.json",
      "class": "record in two test lists; group in both the test list and the training pool of one fold",
      "by": "checker",
      "rule": "FR-008-47",
      "note": ""
    },
    {
      "schema": "split.schema.json",
      "class": "record in no group or in two groups; group id not its smallest original",
      "by": "checker",
      "rule": "FR-008-27",
      "note": "uniqueness across array items"
    },
    {
      "schema": "split.schema.json",
      "class": "Mendeley groups not the 231 components of the 9 links; tests not originals only; training pool not all four versions",
      "by": "checker",
      "rule": "FR-008-28",
      "note": "FR-008-30 for the fold rules"
    },
    {
      "schema": "split.schema.json",
      "class": "fold indices not 0 .. n-1 in order; folds not reproducible from the seed",
      "by": "checker",
      "rule": "FR-008-30",
      "note": ""
    },
    {
      "schema": "data-card.schema.json",
      "class": "YAML alias, anchor, tag, multi-document, implicit boolean, duplicate key",
      "by": "loader",
      "rule": "FR-008-43",
      "note": "loader: pitstudio.contracts.load_json / load_yaml (FR-001-05, FR-001-06)"
    },
    {
      "schema": "data-card.schema.json",
      "class": "id, SPDX id, licence class, redistribution or SHA-256 list differ from the registry entry",
      "by": "checker",
      "rule": "FR-008-44",
      "note": "another file"
    },
    {
      "schema": "data-card.schema.json",
      "class": "required body sections missing",
      "by": "checker",
      "rule": "FR-008-44",
      "note": "Markdown body, not front matter"
    },
    {
      "schema": "data-card.schema.json",
      "class": "validation class not the one FR-008-36 assigns to the data type",
      "by": "checker",
      "rule": "FR-008-36",
      "note": "needs the type table"
    },
    {
      "schema": "data-card.schema.json",
      "class": "licence class not allowed for (spdx, kind) by spec 001 data-model section 5.2",
      "by": "checker",
      "rule": "FR-008-43",
      "note": ""
    }
  ]

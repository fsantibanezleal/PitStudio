{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/machine-params.schema.json",
  "title": "PitStudio machine parameter file",
  "description": "Machine parameter file of published academic dimensions for the MJCF generators and twins (DC-014-02, spec 014-robot-learning).",
  "oneOf": [
    {
      "$ref": "#/$defs/haul_truck"
    },
    {
      "$ref": "#/$defs/excavator"
    },
    {
      "$ref": "#/$defs/loader"
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "https_url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~%!$&'()*+,;=:@/-]*)?(\\?[A-Za-z0-9._~%!$&'()*+,;=:@/?-]*)?$"
    },
    "relpath": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?(/[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?){0,15}$"
    },
    "schema_version": {
      "description": "Contract version (major 1).",
      "type": "string",
      "maxLength": 8,
      "pattern": "^1\\.[0-9]+$"
    },
    "joint": {
      "description": "Revolute joint.",
      "type": "object",
      "required": [
        "lower_deg",
        "upper_deg",
        "torque_max_n_m",
        "velocity_max_deg_per_s"
      ],
      "additionalProperties": false,
      "properties": {
        "lower_deg": {
          "description": "Lower joint limit (deg); lower < upper is a checker rule.",
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "upper_deg": {
          "description": "Upper joint limit (deg).",
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "torque_max_n_m": {
          "description": "Torque limit tau_max (N m), > 0.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000000
        },
        "velocity_max_deg_per_s": {
          "description": "Maximum joint velocity (deg/s), > 0.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 360
        }
      }
    },
    "link": {
      "description": "Rigid link.",
      "type": "object",
      "required": [
        "length_m",
        "mass_kg"
      ],
      "additionalProperties": false,
      "properties": {
        "length_m": {
          "description": "Link length (m).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "mass_kg": {
          "description": "Link mass (kg).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        }
      }
    },
    "source": {
      "description": "Published academic source.",
      "type": "object",
      "required": [
        "id",
        "citation"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "citation": {
          "description": "Authors, year, title, venue.",
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "doi": {
          "description": "DOI.",
          "type": "string",
          "minLength": 1,
          "maxLength": 220,
          "pattern": "^10\\.[0-9]{4,9}/[-._;()/:A-Za-z0-9]{1,200}$"
        },
        "url": {
          "$ref": "#/$defs/https_url"
        },
        "locator": {
          "description": "Table, figure or page of the value.",
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "anyOf": [
        {
          "required": [
            "doi"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ]
    },
    "haul_truck": {
      "description": "Rigid-frame haul truck: chassis, six wheels (two steered front, four driven rear), steering joint.",
      "type": "object",
      "required": [
        "kind",
        "schema_version",
        "id",
        "name",
        "sources",
        "provenance",
        "empty_mass_kg",
        "rated_payload_kg",
        "wheel_mass_kg",
        "wheelbase_m",
        "track_width_m",
        "wheel_radius_m",
        "wheel_width_m",
        "chassis_length_m",
        "chassis_width_m",
        "chassis_height_m",
        "cg_to_front_axle_m",
        "cg_height_m",
        "yaw_inertia_kg_m2",
        "cornering_stiffness_front_n_per_rad",
        "cornering_stiffness_rear_n_per_rad",
        "max_steer_deg",
        "max_steer_rate_deg_per_s",
        "max_rimpull_n",
        "max_retarder_n"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string",
          "maxLength": 200
        },
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "description": "Display name (generic, never a manufacturer's model).",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sources": {
          "description": "Published academic sources of the dimensions.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "provenance": {
          "description": "Field name to its source id; every dimension is cited (checker rule).",
          "type": "object",
          "propertyNames": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "description": "Source of one field.",
            "type": "object",
            "required": [
              "source",
              "class"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "$ref": "#/$defs/slug"
              },
              "class": {
                "enum": [
                  "published",
                  "derived"
                ]
              }
            }
          },
          "maxProperties": 64,
          "minProperties": 1
        },
        "meshes": {
          "description": "Part to mesh file inside the generated asset folder.",
          "type": "object",
          "propertyNames": {
            "maxLength": 16,
            "pattern": "^(chassis|wheel|base|boom|stick|bucket|arm)$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/relpath"
          },
          "maxProperties": 8,
          "minProperties": 1
        },
        "kind": {
          "const": "haul-truck"
        },
        "empty_mass_kg": {
          "description": "Empty mass (kg).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "rated_payload_kg": {
          "description": "Rated payload (kg).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "wheel_mass_kg": {
          "description": "Mass of one wheel (kg).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "wheelbase_m": {
          "description": "Wheelbase (m).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20
        },
        "track_width_m": {
          "description": "Track width (m).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 15
        },
        "wheel_radius_m": {
          "description": "Wheel radius (m).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3
        },
        "wheel_width_m": {
          "description": "Wheel width (m).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3
        },
        "chassis_length_m": {
          "description": "Chassis length (m).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "chassis_width_m": {
          "description": "Chassis width (m).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 15
        },
        "chassis_height_m": {
          "description": "Chassis height (m).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 15
        },
        "cg_to_front_axle_m": {
          "description": "Centre of gravity to front axle (m).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20
        },
        "cg_height_m": {
          "description": "Centre-of-gravity height (m).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "yaw_inertia_kg_m2": {
          "description": "Yaw moment of inertia (kg m2).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000000
        },
        "cornering_stiffness_front_n_per_rad": {
          "description": "Front-axle cornering stiffness (N/rad).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000000
        },
        "cornering_stiffness_rear_n_per_rad": {
          "description": "Rear-axle cornering stiffness (N/rad).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000000
        },
        "max_steer_deg": {
          "description": "Maximum steering angle (deg).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "max_steer_rate_deg_per_s": {
          "description": "Maximum steering rate (deg/s).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 180
        },
        "max_rimpull_n": {
          "description": "Maximum rimpull (N).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "max_retarder_n": {
          "description": "Maximum retarder force (N).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        }
      }
    },
    "excavator": {
      "description": "Excavator: four revolute joints (swing, boom, stick, bucket).",
      "type": "object",
      "required": [
        "kind",
        "schema_version",
        "id",
        "name",
        "sources",
        "provenance",
        "operating_mass_kg",
        "base_mass_kg",
        "boom_pivot_m",
        "links",
        "joints",
        "bucket_width_m",
        "heaped_volume_m3"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string",
          "maxLength": 200
        },
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "description": "Display name (generic, never a manufacturer's model).",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sources": {
          "description": "Published academic sources of the dimensions.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "provenance": {
          "description": "Field name to its source id; every dimension is cited (checker rule).",
          "type": "object",
          "propertyNames": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "description": "Source of one field.",
            "type": "object",
            "required": [
              "source",
              "class"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "$ref": "#/$defs/slug"
              },
              "class": {
                "enum": [
                  "published",
                  "derived"
                ]
              }
            }
          },
          "maxProperties": 64,
          "minProperties": 1
        },
        "meshes": {
          "description": "Part to mesh file inside the generated asset folder.",
          "type": "object",
          "propertyNames": {
            "maxLength": 16,
            "pattern": "^(chassis|wheel|base|boom|stick|bucket|arm)$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/relpath"
          },
          "maxProperties": 8,
          "minProperties": 1
        },
        "kind": {
          "const": "excavator"
        },
        "operating_mass_kg": {
          "description": "Operating mass (kg).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "base_mass_kg": {
          "description": "Undercarriage and house mass (kg).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "boom_pivot_m": {
          "description": "Pivot position (x, z) in the machine frame (m).",
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -20,
            "maximum": 20
          },
          "minItems": 2,
          "maxItems": 2
        },
        "links": {
          "type": "object",
          "required": [
            "boom",
            "stick",
            "bucket"
          ],
          "additionalProperties": false,
          "properties": {
            "boom": {
              "$ref": "#/$defs/link"
            },
            "stick": {
              "$ref": "#/$defs/link"
            },
            "bucket": {
              "$ref": "#/$defs/link"
            }
          }
        },
        "joints": {
          "type": "object",
          "required": [
            "swing",
            "boom",
            "stick",
            "bucket"
          ],
          "additionalProperties": false,
          "properties": {
            "swing": {
              "$ref": "#/$defs/joint"
            },
            "boom": {
              "$ref": "#/$defs/joint"
            },
            "stick": {
              "$ref": "#/$defs/joint"
            },
            "bucket": {
              "$ref": "#/$defs/joint"
            }
          }
        },
        "bucket_width_m": {
          "description": "Bucket width w (m).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "heaped_volume_m3": {
          "description": "Rated heaped bucket volume V_h (m3).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        }
      }
    },
    "loader": {
      "description": "Wheel loader (IL-3): lift and tilt joints.",
      "type": "object",
      "required": [
        "kind",
        "schema_version",
        "id",
        "name",
        "sources",
        "provenance",
        "operating_mass_kg",
        "wheelbase_m",
        "track_width_m",
        "wheel_radius_m",
        "max_steer_deg",
        "max_rimpull_n",
        "arm_pivot_m",
        "links",
        "joints",
        "bucket_width_m",
        "heaped_volume_m3"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string",
          "maxLength": 200
        },
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "description": "Display name (generic, never a manufacturer's model).",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sources": {
          "description": "Published academic sources of the dimensions.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "provenance": {
          "description": "Field name to its source id; every dimension is cited (checker rule).",
          "type": "object",
          "propertyNames": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "description": "Source of one field.",
            "type": "object",
            "required": [
              "source",
              "class"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "$ref": "#/$defs/slug"
              },
              "class": {
                "enum": [
                  "published",
                  "derived"
                ]
              }
            }
          },
          "maxProperties": 64,
          "minProperties": 1
        },
        "meshes": {
          "description": "Part to mesh file inside the generated asset folder.",
          "type": "object",
          "propertyNames": {
            "maxLength": 16,
            "pattern": "^(chassis|wheel|base|boom|stick|bucket|arm)$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/relpath"
          },
          "maxProperties": 8,
          "minProperties": 1
        },
        "kind": {
          "const": "loader"
        },
        "operating_mass_kg": {
          "description": "Operating mass (kg).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "wheelbase_m": {
          "description": "Wheelbase (m).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20
        },
        "track_width_m": {
          "description": "Track width (m).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 15
        },
        "wheel_radius_m": {
          "description": "Wheel radius (m).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3
        },
        "max_steer_deg": {
          "description": "Maximum articulation angle (deg).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "max_rimpull_n": {
          "description": "Maximum rimpull (N).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000000
        },
        "arm_pivot_m": {
          "description": "Pivot position (x, z) in the machine frame (m).",
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -20,
            "maximum": 20
          },
          "minItems": 2,
          "maxItems": 2
        },
        "links": {
          "type": "object",
          "required": [
            "arm",
            "bucket"
          ],
          "additionalProperties": false,
          "properties": {
            "arm": {
              "$ref": "#/$defs/link"
            },
            "bucket": {
              "$ref": "#/$defs/link"
            }
          }
        },
        "joints": {
          "type": "object",
          "required": [
            "lift",
            "tilt"
          ],
          "additionalProperties": false,
          "properties": {
            "lift": {
              "$ref": "#/$defs/joint"
            },
            "tilt": {
              "$ref": "#/$defs/joint"
            }
          }
        },
        "bucket_width_m": {
          "description": "Bucket width w (m).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "heaped_volume_m3": {
          "description": "Rated heaped bucket volume V_h (m3).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        }
      }
    }
  }
}

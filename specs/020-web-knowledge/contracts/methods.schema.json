{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/methods.schema.json",
  "title": "Method registry",
  "description": "The method ladder M1-M23 of studio/methods.yaml (DC-020-01, spec 020-web-knowledge).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "methods"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 0,
      "maxLength": 200
    },
    "methods": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/method"
      },
      "minItems": 23,
      "maxItems": 23
    }
  },
  "$defs": {
    "case_id": {
      "enum": [
        "A1",
        "A2",
        "A3",
        "B1",
        "B2",
        "C1",
        "C2",
        "C3",
        "D1",
        "D2",
        "E1",
        "E2"
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "metric",
        "pairing_unit",
        "n"
      ],
      "properties": {
        "baseline": {
          "$ref": "#/$defs/name_en_es"
        },
        "metric": {
          "$ref": "#/$defs/metric"
        },
        "pairing_unit": {
          "$ref": "#/$defs/name_en_es"
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "description": "Pre-registered comparison design: baseline, metric with unit and orientation, pairing unit and number of pairs."
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "requirement",
        "spec"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/text_en_es"
        },
        "requirement": {
          "type": "string",
          "maxLength": 9,
          "pattern": "^SC-[0-9]{3}-[0-9]{2}$"
        },
        "spec": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9]{3}-[a-z0-9-]{1,60}$"
        }
      },
      "description": "Acceptance criterion copied from the owning model spec's SC row."
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "tiers",
        "implementation",
        "spdx",
        "lanes",
        "learned",
        "cases",
        "docs_page"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/method_id"
        },
        "name": {
          "$ref": "#/$defs/name_en_es"
        },
        "tiers": {
          "type": "array",
          "items": {
            "enum": [
              "classical",
              "sota",
              "beyond-sota",
              "frontier"
            ]
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "implementation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "spdx": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spdx_id"
          },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "lanes": {
          "type": "array",
          "items": {
            "enum": [
              "live",
              "precompute",
              "replay"
            ]
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "learned": {
          "type": "boolean"
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/case_id"
          },
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true
        },
        "comparison": {
          "$ref": "#/$defs/comparison"
        },
        "criterion": {
          "$ref": "#/$defs/criterion"
        },
        "docs_page": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^docs/methods/m(0[1-9]|1[0-9]|2[0-3])-[a-z0-9-]{1,64}\\.md$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "learned": {
                "const": true
              }
            },
            "required": [
              "learned"
            ]
          },
          "then": {
            "required": [
              "comparison",
              "criterion"
            ]
          }
        }
      ]
    },
    "method_id": {
      "enum": [
        "M1",
        "M2",
        "M3",
        "M4",
        "M5",
        "M6",
        "M7",
        "M8",
        "M9",
        "M10",
        "M11",
        "M12",
        "M13",
        "M14",
        "M15",
        "M16",
        "M17",
        "M18",
        "M19",
        "M20",
        "M21",
        "M22",
        "M23"
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "unit",
        "orientation"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name_en_es"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "orientation": {
          "enum": [
            "higher-is-better",
            "lower-is-better"
          ]
        }
      }
    },
    "name_en_es": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "es"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "es": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "spdx_id": {
      "enum": [
        "LicenseRef-USGov-PD",
        "CC0-1.0",
        "DL-DE-ZERO-2.0",
        "CC-BY-4.0",
        "LicenseRef-Copernicus-CLMS",
        "CC-BY-SA-3.0",
        "CC-BY-SA-4.0",
        "Apache-2.0",
        "MIT",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "MPL-2.0",
        "LGPL-2.1-or-later",
        "LicenseRef-TOST-1.0",
        "LicenseRef-NVIDIA-Open-Model",
        "LicenseRef-NVIDIA-SLA",
        "LicenseRef-NvidiaProprietary",
        "LicenseRef-NVIDIA-Omniverse",
        "LicenseRef-TensorRT-SLA",
        "LicenseRef-TensorRT-RTX-SLA"
      ]
    },
    "text_en_es": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "es"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "es": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    }
  }
}

  "not_schema_checkable": [
    {
      "schema": "console.schema.json",
      "class": "job request: malformed JSON, NaN, duplicate key, byte-order mark",
      "by": "loader",
      "rule": "FR-003-10"
    },
    {
      "schema": "console.schema.json",
      "class": "job request larger than 65,536 bytes (with or without Content-Length, chunked)",
      "by": "loader",
      "rule": "FR-003-10"
    },
    {
      "schema": "console.schema.json",
      "class": "job request naming an unknown recipe, stage key or profile",
      "by": "checker",
      "rule": "FR-003-10"
    },
    {
      "schema": "console.schema.json",
      "class": "job_created location different from /jobs/<job_id>",
      "by": "checker",
      "rule": "FR-003-09"
    },
    {
      "schema": "console.schema.json",
      "class": "problem status different from the HTTP status",
      "by": "checker",
      "rule": "FR-003-22"
    },
    {
      "schema": "console.schema.json",
      "class": "problem detail or message containing an absolute path",
      "by": "checker",
      "rule": "FR-003-22"
    },
    {
      "schema": "console.schema.json",
      "class": "recipe summary sha256 different from the file's digest",
      "by": "checker",
      "rule": "FR-003-07"
    },
    {
      "schema": "console.schema.json",
      "class": "job shards.done greater than shards.total",
      "by": "checker",
      "rule": "-",
      "note": "no requirement states it; the runner's job record should never report it"
    }

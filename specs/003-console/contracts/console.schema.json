{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/console.schema.json",
  "title": "PitStudio console response bodies",
  "description": "Response bodies of the loopback console API (DC-003-01, spec 003-console).",
  "oneOf": [
    {
      "$ref": "#/$defs/health"
    },
    {
      "$ref": "#/$defs/recipe_summary"
    },
    {
      "$ref": "#/$defs/recipe_list"
    },
    {
      "$ref": "#/$defs/job"
    },
    {
      "$ref": "#/$defs/job_list"
    },
    {
      "$ref": "#/$defs/job_created"
    },
    {
      "$ref": "#/$defs/run_summary"
    },
    {
      "$ref": "#/$defs/run_list"
    },
    {
      "$ref": "#/$defs/problem"
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "run_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]{0,47}$"
    },
    "sha256": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "utc_timestamp": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"
    },
    "semver": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "case_id": {
      "enum": [
        "A1",
        "A2",
        "A3",
        "B1",
        "B2",
        "C1",
        "C2",
        "C3",
        "D1",
        "D2",
        "E1",
        "E2"
      ]
    },
    "job_id": {
      "type": "string",
      "maxLength": 25,
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
    },
    "job_state": {
      "description": "runner job states (spec 002 plan.md D3)",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "blocked",
        "held",
        "interrupted"
      ]
    },
    "error_item": {
      "type": "object",
      "description": "one validation error: instance JSON pointer, schema keyword or loader code, one-line message",
      "additionalProperties": false,
      "required": [
        "pointer",
        "keyword",
        "message"
      ],
      "properties": {
        "pointer": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^(/[^/\\x00-\\x1f\\x7f]*)*$"
        },
        "keyword": {
          "type": "string",
          "maxLength": 48,
          "pattern": "^[A-Za-z$][A-Za-z0-9_-]{0,47}$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$"
        }
      }
    },
    "contract_version": {
      "description": "a contract's schema_version, or its exact PitStudio $id",
      "oneOf": [
        {
          "type": "string",
          "maxLength": 8,
          "pattern": "^[0-9]{1,3}\\.[0-9]{1,4}$"
        },
        {
          "type": "string",
          "maxLength": 120,
          "pattern": "^https://fsantibanezleal\\.github\\.io/PitStudio/contracts/[a-z][a-z0-9-]{0,31}\\.schema\\.json$"
        }
      ]
    },
    "health": {
      "type": "object",
      "description": "GET /health (FR-003-06): the only body readable from the public site, so no free text, path, host or user name",
      "additionalProperties": false,
      "required": [
        "status",
        "console_version",
        "runner_version",
        "contracts"
      ],
      "properties": {
        "status": {
          "const": "ok"
        },
        "console_version": {
          "$ref": "#/$defs/semver"
        },
        "runner_version": {
          "$ref": "#/$defs/semver"
        },
        "contracts": {
          "type": "object",
          "description": "schema stem -> contract version",
          "propertyNames": {
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/contract_version"
          },
          "minProperties": 1,
          "maxProperties": 16
        }
      }
    },
    "recipe_path": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^studio/recipes/(cases|_bench)/[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?\\.yaml$"
    },
    "recipe_summary": {
      "type": "object",
      "description": "one recipe file (FR-003-07); id and case are null when an invalid file does not yield them",
      "additionalProperties": false,
      "required": [
        "id",
        "case",
        "path",
        "sha256",
        "stages",
        "valid",
        "errors"
      ],
      "properties": {
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/slug"
            },
            {
              "type": "null"
            }
          ]
        },
        "case": {
          "anyOf": [
            {
              "$ref": "#/$defs/case_id"
            },
            {
              "const": "bench"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "$ref": "#/$defs/recipe_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "valid": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error_item"
          },
          "maxItems": 20
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "valid": {
                "const": true
              }
            },
            "required": [
              "valid"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "not": {
                  "const": null
                }
              },
              "case": {
                "not": {
                  "const": null
                }
              },
              "stages": {
                "minimum": 1
              },
              "errors": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "errors": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "recipe_list": {
      "type": "object",
      "description": "GET /recipes",
      "additionalProperties": false,
      "required": [
        "recipes"
      ],
      "properties": {
        "recipes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recipe_summary"
          },
          "maxItems": 256
        }
      }
    },
    "job": {
      "type": "object",
      "description": "a runner job record (FR-003-08); exit_code is the runner exit code of spec 002 plan.md D2",
      "additionalProperties": false,
      "required": [
        "job_id",
        "recipe",
        "state",
        "run_id",
        "created",
        "stage",
        "shards",
        "exit_code",
        "reason"
      ],
      "properties": {
        "job_id": {
          "$ref": "#/$defs/job_id"
        },
        "recipe": {
          "$ref": "#/$defs/slug"
        },
        "state": {
          "$ref": "#/$defs/job_state"
        },
        "run_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/run_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "created": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "stage": {
          "anyOf": [
            {
              "$ref": "manifest.schema.json#/$defs/stage_key"
            },
            {
              "type": "null"
            }
          ]
        },
        "shards": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "done",
                "total"
              ],
              "properties": {
                "done": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "total": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 6
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "^[^\\x00-\\x1f\\x7f]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "queued",
                  "running"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "succeeded"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "held"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "not": {
                  "const": null
                }
              }
            }
          }
        }
      ]
    },
    "job_list": {
      "type": "object",
      "description": "GET /queue",
      "additionalProperties": false,
      "required": [
        "jobs"
      ],
      "properties": {
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/job"
          },
          "maxItems": 1000
        }
      }
    },
    "job_created": {
      "type": "object",
      "description": "202 body of POST /jobs (FR-003-09); location equals the Location header",
      "additionalProperties": false,
      "required": [
        "job_id",
        "location"
      ],
      "properties": {
        "job_id": {
          "$ref": "#/$defs/job_id"
        },
        "location": {
          "type": "string",
          "maxLength": 31,
          "pattern": "^/jobs/[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
        }
      }
    },
    "run_summary": {
      "type": "object",
      "description": "one run of the store (FR-003-12); manifest fields are null when the manifest is invalid, state is null when no queue record exists",
      "additionalProperties": false,
      "required": [
        "run_id",
        "recipe",
        "created",
        "profile",
        "state",
        "stages",
        "published",
        "valid"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/run_id"
        },
        "recipe": {
          "anyOf": [
            {
              "$ref": "#/$defs/slug"
            },
            {
              "type": "null"
            }
          ]
        },
        "created": {
          "anyOf": [
            {
              "$ref": "#/$defs/utc_timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/slug"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/job_state"
            },
            {
              "type": "null"
            }
          ]
        },
        "stages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "published": {
          "type": "boolean"
        },
        "valid": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "valid": {
                "const": true
              }
            },
            "required": [
              "valid"
            ]
          },
          "then": {
            "properties": {
              "recipe": {
                "not": {
                  "const": null
                }
              },
              "created": {
                "not": {
                  "const": null
                }
              },
              "profile": {
                "not": {
                  "const": null
                }
              },
              "stages": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "run_list": {
      "type": "object",
      "description": "GET /runs",
      "additionalProperties": false,
      "required": [
        "runs"
      ],
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/run_summary"
          },
          "maxItems": 1000
        }
      }
    },
    "problem": {
      "type": "object",
      "description": "application/problem+json error body (RFC 9457, FR-003-22); one-line texts, no stack trace",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "status",
        "detail"
      ],
      "properties": {
        "type": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^(about:blank|https://[A-Za-z0-9.-]+(/[A-Za-z0-9._~%-]+)*)$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$"
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "detail": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/error_item"
          },
          "maxItems": 50
        }
      }
    },
    "job_request": {
      "description": "POST /jobs body: spec 001's job request, referenced, never redefined (DC-003-03)",
      "$ref": "recipe.schema.json#/$defs/job_request"
    }
  }
}

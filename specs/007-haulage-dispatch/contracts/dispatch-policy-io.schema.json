{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/dispatch-policy-io.schema.json",
  "title": "Dispatch policy input/output layout",
  "description": "Tensor layout, feature order, units, normalisation, masks and tie rule of an exported dispatch policy, written by s60_export (DC-007-04, spec 007-haulage-dispatch).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "layout_version",
    "policy",
    "inputs",
    "output",
    "decision",
    "padding",
    "time_unit"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 200
    },
    "schema_version": {
      "$ref": "#/$defs/schema_version"
    },
    "layout_version": {
      "const": 1
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "padding": {
      "$ref": "#/$defs/padding"
    },
    "time_unit": {
      "const": "h"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "relpath": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?(/[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?){0,15}$"
    },
    "artefact_id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "schema_version": {
      "type": "string",
      "maxLength": 8,
      "pattern": "^1\\.[0-9]{1,4}$"
    },
    "onnx": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes",
        "opset",
        "ir_version"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relpath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "exclusiveMaximum": 2000000
        },
        "opset": {
          "type": "integer",
          "minimum": 17,
          "maximum": 19
        },
        "ir_version": {
          "const": 10
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "architecture",
        "artefact_id",
        "onnx"
      ],
      "properties": {
        "id": {
          "enum": [
            "ppo",
            "attention"
          ]
        },
        "architecture": {
          "enum": [
            "shared-mlp",
            "dense-attention"
          ]
        },
        "artefact_id": {
          "$ref": "#/$defs/artefact_id"
        },
        "onnx": {
          "$ref": "#/$defs/onnx"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "const": "ppo"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "architecture": {
                "const": "shared-mlp"
              }
            }
          },
          "else": {
            "properties": {
              "architecture": {
                "const": "dense-attention"
              }
            }
          }
        }
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truck_features",
        "target_features",
        "truck_mask",
        "target_mask"
      ],
      "properties": {
        "truck_features": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "dtype",
            "shape",
            "features"
          ],
          "properties": {
            "name": {
              "const": "truck_features"
            },
            "dtype": {
              "const": "float32"
            },
            "shape": {
              "const": [
                1,
                40,
                12
              ]
            },
            "features": {
              "const": [
                {
                  "index": 0,
                  "name": "state_travel_empty",
                  "unit": "1",
                  "transform": "one-hot truck state"
                },
                {
                  "index": 1,
                  "name": "state_queue_loader",
                  "unit": "1",
                  "transform": "one-hot truck state"
                },
                {
                  "index": 2,
                  "name": "state_loading",
                  "unit": "1",
                  "transform": "one-hot truck state"
                },
                {
                  "index": 3,
                  "name": "state_travel_loaded",
                  "unit": "1",
                  "transform": "one-hot truck state"
                },
                {
                  "index": 4,
                  "name": "state_queue_dump",
                  "unit": "1",
                  "transform": "one-hot truck state"
                },
                {
                  "index": 5,
                  "name": "state_dumping",
                  "unit": "1",
                  "transform": "one-hot truck state"
                },
                {
                  "index": 6,
                  "name": "state_parked_or_down",
                  "unit": "1",
                  "transform": "one-hot truck state"
                },
                {
                  "index": 7,
                  "name": "payload_ratio",
                  "unit": "1",
                  "transform": "payload / class mean payload"
                },
                {
                  "index": 8,
                  "name": "time_left_in_state_h",
                  "unit": "h",
                  "transform": "identity"
                },
                {
                  "index": 9,
                  "name": "eta_to_target_h",
                  "unit": "h",
                  "transform": "identity"
                },
                {
                  "index": 10,
                  "name": "deciding",
                  "unit": "1",
                  "transform": "1 for the deciding truck, else 0"
                },
                {
                  "index": 11,
                  "name": "valid",
                  "unit": "1",
                  "transform": "1 for a real truck slot, 0 for padding"
                }
              ]
            }
          }
        },
        "target_features": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "dtype",
            "shape",
            "features"
          ],
          "properties": {
            "name": {
              "const": "target_features"
            },
            "dtype": {
              "const": "float32"
            },
            "shape": {
              "const": [
                1,
                16,
                9
              ]
            },
            "features": {
              "const": [
                {
                  "index": 0,
                  "name": "is_dump",
                  "unit": "1",
                  "transform": "0 = loader, 1 = dump"
                },
                {
                  "index": 1,
                  "name": "queued_frac",
                  "unit": "1",
                  "transform": "queued trucks / 40"
                },
                {
                  "index": 2,
                  "name": "inbound_frac",
                  "unit": "1",
                  "transform": "inbound trucks / 40"
                },
                {
                  "index": 3,
                  "name": "time_until_free_h",
                  "unit": "h",
                  "transform": "identity"
                },
                {
                  "index": 4,
                  "name": "backlog_h",
                  "unit": "h",
                  "transform": "identity"
                },
                {
                  "index": 5,
                  "name": "mean_service_time_h",
                  "unit": "h",
                  "transform": "identity"
                },
                {
                  "index": 6,
                  "name": "deciding_truck_eta_h",
                  "unit": "h",
                  "transform": "identity; 0 when masked"
                },
                {
                  "index": 7,
                  "name": "spots_frac",
                  "unit": "1",
                  "transform": "loading spots / 4"
                },
                {
                  "index": 8,
                  "name": "serviceable",
                  "unit": "1",
                  "transform": "1 if serviceable, else 0"
                }
              ]
            }
          }
        },
        "truck_mask": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "dtype",
            "shape",
            "meaning"
          ],
          "properties": {
            "name": {
              "const": "truck_mask"
            },
            "dtype": {
              "const": "bool"
            },
            "shape": {
              "const": [
                1,
                40
              ]
            },
            "meaning": {
              "const": "true = real truck slot"
            }
          }
        },
        "target_mask": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "dtype",
            "shape",
            "meaning"
          ],
          "properties": {
            "name": {
              "const": "target_mask"
            },
            "dtype": {
              "const": "bool"
            },
            "shape": {
              "const": [
                1,
                16
              ]
            },
            "meaning": {
              "const": "true = serviceable and reachable for the deciding truck"
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dtype",
        "shape",
        "meaning"
      ],
      "properties": {
        "name": {
          "const": "logits"
        },
        "dtype": {
          "const": "float32"
        },
        "shape": {
          "const": [
            1,
            16
          ]
        },
        "meaning": {
          "const": "one logit per target slot"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "masking",
        "applied_by",
        "selection",
        "tie_rule"
      ],
      "properties": {
        "masking": {
          "const": "masked target has probability 0"
        },
        "applied_by": {
          "const": "des"
        },
        "selection": {
          "const": "argmax"
        },
        "tie_rule": {
          "const": "lowest-target-index"
        }
      }
    },
    "padding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_trucks",
        "max_targets"
      ],
      "properties": {
        "max_trucks": {
          "const": 40
        },
        "max_targets": {
          "const": 16
        }
      }
    }
  }
}

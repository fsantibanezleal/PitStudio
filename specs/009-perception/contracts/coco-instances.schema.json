{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/coco-instances.schema.json",
  "title": "COCO instances subset",
  "description": "Closed COCO instances subset (images, polygon annotations with iscrowd 0, the five perception categories) written by st55_sdg and the dataset builder (DC-009-02, spec 009-perception).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "images",
    "annotations",
    "categories"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 200
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "items": {
        "$ref": "#/$defs/image"
      }
    },
    "annotations": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "$ref": "#/$defs/annotation"
      }
    },
    "categories": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/category"
      }
    }
  },
  "$defs": {
    "relpath": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?(/[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?){0,15}$"
    },
    "coco_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "coordinate_px": {
      "type": "number",
      "minimum": -0.5,
      "maximum": 8192.5
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "file_name",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/coco_id"
        },
        "file_name": {
          "$ref": "#/$defs/relpath"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        }
      }
    },
    "polygon": {
      "type": "array",
      "minItems": 6,
      "maxItems": 8192,
      "items": {
        "$ref": "#/$defs/coordinate_px"
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "image_id",
        "category_id",
        "bbox",
        "segmentation",
        "area",
        "iscrowd"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/coco_id"
        },
        "image_id": {
          "$ref": "#/$defs/coco_id"
        },
        "category_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/coordinate_px"
          }
        },
        "segmentation": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/polygon"
          }
        },
        "area": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 67108864
        },
        "iscrowd": {
          "const": 0
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "name": {
          "enum": [
            "haul_truck",
            "shovel",
            "light_vehicle",
            "person",
            "boulder"
          ]
        },
        "supercategory": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-z][a-z_]{0,31}$"
        }
      },
      "oneOf": [
        {
          "properties": {
            "id": {
              "const": 1
            },
            "name": {
              "const": "haul_truck"
            }
          }
        },
        {
          "properties": {
            "id": {
              "const": 2
            },
            "name": {
              "const": "shovel"
            }
          }
        },
        {
          "properties": {
            "id": {
              "const": 3
            },
            "name": {
              "const": "light_vehicle"
            }
          }
        },
        {
          "properties": {
            "id": {
              "const": 4
            },
            "name": {
              "const": "person"
            }
          }
        },
        {
          "properties": {
            "id": {
              "const": 5
            },
            "name": {
              "const": "boulder"
            }
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/physics-observables.schema.json",
  "title": "Physics observables table description",
  "description": "Description of a Parquet observables table written by st50_physics, stored as the file's key-value metadata (DC-005-03, spec 005-physics).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "scenario",
    "solver",
    "solver_version",
    "warp_version",
    "seed",
    "device",
    "dt_mode",
    "dt_s",
    "budget",
    "rows",
    "columns",
    "stamp"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 200
    },
    "kind": {
      "const": "physics-observables"
    },
    "schema_version": {
      "$ref": "#/$defs/schema_version"
    },
    "scenario": {
      "$ref": "#/$defs/slug"
    },
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "solver": {
      "$ref": "physics-scenario.schema.json#/$defs/solver"
    },
    "solver_version": {
      "description": "version of the solver package read from studio/uv.lock (warp-lang for own Warp solvers, newton for Newton solvers)",
      "$ref": "#/$defs/version"
    },
    "warp_version": {
      "$ref": "#/$defs/version"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "device": {
      "enum": [
        "cpu",
        "cuda"
      ]
    },
    "dt_mode": {
      "description": "fixed step, or the CFL step of the shallow-water solver (FR-005-23)",
      "enum": [
        "fixed",
        "cfl"
      ]
    },
    "dt_s": {
      "description": "the fixed step, or the smallest CFL step taken",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10
    },
    "dt_max_s": {
      "description": "the largest CFL step taken",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10
    },
    "rayleigh_dt_s": {
      "description": "Rayleigh time step of the smallest particle (FR-005-08)",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10
    },
    "rayleigh_fraction": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "youngs_modulus": {
      "description": "both values when a reduced Young's modulus is used (FR-005-09)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "used_pa",
        "real_pa"
      ],
      "properties": {
        "used_pa": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000000.0
        },
        "real_pa": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000000.0
        }
      }
    },
    "budget": {
      "description": "conserved quantity of the budget series (FR-005-15, FR-005-20, FR-005-28, FR-005-37, FR-005-42)",
      "enum": [
        "mass",
        "volume",
        "energy"
      ]
    },
    "rows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/column"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "role": {
                "const": "time"
              }
            },
            "required": [
              "role"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "budget"
              }
            },
            "required": [
              "role"
            ]
          }
        }
      ]
    },
    "stamp": {
      "$ref": "physics-benchmark-report.schema.json#/$defs/stamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "solver": {
            "const": "dem"
          }
        },
        "required": [
          "solver"
        ]
      },
      "then": {
        "required": [
          "rayleigh_dt_s",
          "rayleigh_fraction"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "dt_mode": {
            "const": "cfl"
          }
        },
        "required": [
          "dt_mode"
        ]
      },
      "then": {
        "required": [
          "dt_max_s"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "solver": {
            "const": "swe"
          }
        },
        "required": [
          "solver"
        ]
      },
      "then": {
        "properties": {
          "dt_mode": {
            "const": "cfl"
          },
          "budget": {
            "const": "volume"
          }
        }
      },
      "else": {
        "properties": {
          "dt_mode": {
            "const": "fixed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "solver": {
            "enum": [
              "vehicles",
              "rigid-newton"
            ]
          }
        },
        "required": [
          "solver"
        ]
      },
      "then": {
        "properties": {
          "budget": {
            "const": "energy"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "solver": {
            "enum": [
              "dem",
              "mpm-newton",
              "mlsmpm2d",
              "dust"
            ]
          }
        },
        "required": [
          "solver"
        ]
      },
      "then": {
        "properties": {
          "budget": {
            "const": "mass"
          }
        }
      }
    }
  ],
  "$defs": {
    "unit": {
      "description": "UCUM case-sensitive unit codes; 1 is dimensionless (also counts)",
      "enum": [
        "1",
        "1/s",
        "s",
        "m",
        "m2",
        "m3",
        "m/s",
        "m/s2",
        "m2/s",
        "m3/s",
        "kg",
        "kg/s",
        "kg/m2",
        "kg/m3",
        "Pa",
        "Pa.s",
        "N",
        "N/m",
        "N.m",
        "W",
        "J",
        "deg",
        "rad/s"
      ]
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "unit",
        "dtype",
        "role"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/param_key"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "dtype": {
          "enum": [
            "float32",
            "float64",
            "int32",
            "int64",
            "uint32",
            "uint64",
            "bool"
          ]
        },
        "role": {
          "description": "time axis, step index, observable, budget series term, swept parameter",
          "enum": [
            "time",
            "step",
            "observable",
            "budget",
            "parameter"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "time"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "s"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "step"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "1"
              },
              "dtype": {
                "enum": [
                  "int32",
                  "int64",
                  "uint32",
                  "uint64"
                ]
              }
            }
          }
        }
      ]
    },
    "schema_version": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^1\\.[0-9]+$"
    },
    "param_key": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "run_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]{0,47}$"
    },
    "slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/physics-benchmark-report.schema.json",
  "title": "Physics benchmark report",
  "description": "One row per physics benchmark with its oracle, tolerance and verdict, written by st50_physics (DC-005-05, spec 005-physics).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "report_id",
    "created",
    "run_id",
    "git_sha",
    "device",
    "rows",
    "overhead"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 200
    },
    "kind": {
      "const": "physics-benchmark-report"
    },
    "schema_version": {
      "$ref": "#/$defs/schema_version"
    },
    "report_id": {
      "$ref": "#/$defs/artefact_id"
    },
    "created": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "git_sha": {
      "$ref": "#/$defs/git_sha"
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "cpu",
            "cuda"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "overhead": {
      "description": "run-time overhead factor of Warp's deterministic mode, once per Warp solver (FR-005-48, NFR-005-05)",
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/overhead"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "device": {
            "properties": {
              "kind": {
                "const": "cpu"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "device"
        ]
      },
      "then": {
        "properties": {
          "rows": {
            "items": {
              "if": {
                "properties": {
                  "gpu_only": {
                    "const": true
                  }
                },
                "required": [
                  "gpu_only"
                ]
              },
              "then": {
                "properties": {
                  "verdict": {
                    "const": "not run"
                  },
                  "reason": {
                    "const": "no GPU"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "not run"
      ]
    },
    "stamp": {
      "description": "the stamp every rollout output carries: the benchmark report of its solver version and its verdict (FR-005-47)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_id",
        "report_sha256",
        "verdict"
      ],
      "properties": {
        "report_id": {
          "$ref": "#/$defs/artefact_id"
        },
        "report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        }
      }
    },
    "material_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "card_sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "card_sha256": {
          "description": "SHA-256 of the RFC 8785 canonical JSON of the material card",
          "$ref": "#/$defs/sha256"
        },
        "youngs_modulus_pa": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000000.0
        },
        "youngs_modulus_real_pa": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000000.0
        }
      },
      "dependentRequired": {
        "youngs_modulus_real_pa": [
          "youngs_modulus_pa"
        ]
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source",
        "status"
      ],
      "properties": {
        "kind": {
          "enum": [
            "analytical",
            "published",
            "reference-implementation",
            "hand-calculation",
            "material-card"
          ]
        },
        "source": {
          "description": "citation with section, table or page",
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "url": {
          "$ref": "#/$defs/https_url"
        },
        "status": {
          "$ref": "physics-scenario.schema.json#/$defs/status"
        }
      }
    },
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "description": "abs: |measured - oracle| <= value; rel: <= value x |oracle|; interval: lower <= measured <= upper; factor: lower <= measured / oracle <= upper",
          "enum": [
            "abs",
            "rel",
            "interval",
            "factor"
          ]
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000000.0
        },
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "abs",
                  "rel"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "interval",
                  "factor"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "lower",
              "upper"
            ]
          }
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantity",
        "unit",
        "measured",
        "oracle",
        "tolerance",
        "pass"
      ],
      "properties": {
        "quantity": {
          "$ref": "#/$defs/param_key"
        },
        "unit": {
          "$ref": "physics-observables.schema.json#/$defs/unit"
        },
        "measured": {
          "type": "number"
        },
        "oracle": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "tolerance": {
          "$ref": "#/$defs/tolerance"
        },
        "pass": {
          "type": "boolean"
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark",
        "solver",
        "solver_version",
        "material",
        "parameters",
        "oracle",
        "checks",
        "verdict",
        "gpu_only",
        "deterministic"
      ],
      "properties": {
        "benchmark": {
          "$ref": "physics-scenario.schema.json#/$defs/benchmark_id"
        },
        "solver": {
          "$ref": "physics-scenario.schema.json#/$defs/solver"
        },
        "solver_version": {
          "$ref": "#/$defs/version"
        },
        "material": {
          "anyOf": [
            {
              "$ref": "#/$defs/material_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "maxLength": 200
              }
            ]
          },
          "maxProperties": 64
        },
        "oracle": {
          "$ref": "#/$defs/oracle"
        },
        "checks": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "gpu_only": {
          "type": "boolean"
        },
        "deterministic": {
          "type": "boolean"
        },
        "outputs_sha256": {
          "description": "SHA-256 of the run's outputs, reproduced on a re-run in deterministic mode (FR-005-48)",
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "not run"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "checks": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "enum": [
                  "pass",
                  "fail"
                ]
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "properties": {
              "checks": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "overhead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solver",
        "device",
        "factor"
      ],
      "properties": {
        "solver": {
          "enum": [
            "dem",
            "mlsmpm2d",
            "swe",
            "dust",
            "vehicles"
          ]
        },
        "device": {
          "enum": [
            "cpu",
            "cuda"
          ]
        },
        "factor": {
          "description": "wall time in deterministic mode divided by wall time in the default mode",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        }
      }
    },
    "schema_version": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^1\\.[0-9]+$"
    },
    "artefact_id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "git_sha": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "https_url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~%!$&'()*+,;=:@/-]*)?(\\?[A-Za-z0-9._~%!$&'()*+,;=:@/?-]*)?$"
    },
    "param_key": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "run_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]{0,47}$"
    },
    "sha256": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "utc_timestamp": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$"
    }
  }
}

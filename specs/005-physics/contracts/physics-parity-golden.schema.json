{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/physics-parity-golden.schema.json",
  "title": "Physics parity golden",
  "description": "Initial state, scenario and golden observables of one browser-twin scenario, written by st50_physics in Warp's deterministic mode (DC-005-06, spec 005-physics).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "golden_id",
    "created",
    "git_sha",
    "twin",
    "engine",
    "solver_version",
    "scenario",
    "scenario_sha256",
    "initial_state",
    "observables",
    "outputs_sha256"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 200
    },
    "kind": {
      "const": "physics-parity-golden"
    },
    "schema_version": {
      "$ref": "#/$defs/schema_version"
    },
    "golden_id": {
      "$ref": "#/$defs/slug"
    },
    "created": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "git_sha": {
      "$ref": "#/$defs/git_sha"
    },
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "twin": {
      "$ref": "physics-scenario.schema.json#/$defs/twin"
    },
    "engine": {
      "description": "web engine id of the twin (spec 018 engine table)",
      "enum": [
        "granular",
        "swe",
        "dust-particles"
      ]
    },
    "solver_version": {
      "description": "warp-lang version read from studio/uv.lock",
      "$ref": "#/$defs/version"
    },
    "scenario": {
      "description": "the scenario parameters (DC-005-01) the golden was produced with; seed and parameters live here",
      "$ref": "physics-scenario.schema.json",
      "properties": {
        "kind": {
          "const": "parity-golden"
        }
      }
    },
    "scenario_sha256": {
      "description": "SHA-256 of the RFC 8785 canonical JSON of scenario",
      "$ref": "#/$defs/sha256"
    },
    "initial_state": {
      "$ref": "#/$defs/initial_state"
    },
    "observables": {
      "$ref": "#/$defs/observables"
    },
    "outputs_sha256": {
      "description": "SHA-256 of the deterministic run's outputs (FR-005-22, FR-005-48)",
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "twin": {
            "const": "dem-pile"
          }
        },
        "required": [
          "twin"
        ]
      },
      "then": {
        "properties": {
          "engine": {
            "const": "granular"
          },
          "scenario": {
            "properties": {
              "twin": {
                "const": "dem-pile"
              },
              "solver": {
                "const": "dem"
              }
            }
          },
          "observables": {
            "required": [
              "repose_deg"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "twin": {
            "const": "mlsmpm2d-collapse"
          }
        },
        "required": [
          "twin"
        ]
      },
      "then": {
        "properties": {
          "engine": {
            "const": "granular"
          },
          "scenario": {
            "properties": {
              "twin": {
                "const": "mlsmpm2d-collapse"
              },
              "solver": {
                "const": "mlsmpm2d"
              }
            }
          },
          "observables": {
            "required": [
              "runout_m"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "twin": {
            "const": "swe-dam-break"
          }
        },
        "required": [
          "twin"
        ]
      },
      "then": {
        "properties": {
          "engine": {
            "const": "swe"
          },
          "scenario": {
            "properties": {
              "twin": {
                "const": "swe-dam-break"
              },
              "solver": {
                "const": "swe"
              }
            }
          },
          "observables": {
            "required": [
              "runout_m"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "twin": {
            "const": "dust-release"
          }
        },
        "required": [
          "twin"
        ]
      },
      "then": {
        "properties": {
          "engine": {
            "const": "dust-particles"
          },
          "scenario": {
            "properties": {
              "twin": {
                "const": "dust-release"
              },
              "solver": {
                "const": "dust"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "initial_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "bytes",
        "layout",
        "items"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/relpath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "layout": {
          "description": "little-endian float32 arrays: particle positions and velocities (2-D or 3-D), or the depth and bed grids",
          "enum": [
            "particles-xyz-vxyz-f32le",
            "particles-xy-vxy-f32le",
            "grid-depth-bed-f32le"
          ]
        },
        "items": {
          "description": "particles or cells (twin caps: 2 x 10^4 particles, 256 x 256 cells)",
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "t_s",
        "values"
      ],
      "properties": {
        "unit": {
          "enum": [
            "kg/s",
            "m3/s"
          ]
        },
        "t_s": {
          "type": "array",
          "minItems": 2,
          "maxItems": 1024,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000
          }
        },
        "values": {
          "type": "array",
          "minItems": 2,
          "maxItems": 1024,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000000000.0
          }
        }
      }
    },
    "observables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mass_drift_rel"
      ],
      "properties": {
        "repose_deg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 90
        },
        "runout_m": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "discharge": {
          "description": "Q(t)",
          "$ref": "#/$defs/series"
        },
        "mass_drift_rel": {
          "description": "|total mass (or volume) at the end - initial| / initial; bounded by the loosest conservation requirement of the twin solvers (FR-005-28)",
          "type": "number",
          "minimum": 0,
          "maximum": 1e-05
        }
      }
    },
    "schema_version": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^1\\.[0-9]+$"
    },
    "git_sha": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "relpath": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?(/[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?){0,15}$"
    },
    "run_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]{0,47}$"
    },
    "sha256": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "utc_timestamp": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/engines/granular.schema.json",
  "title": "Engine granular: input and output messages",
  "description": "Input and output messages of the browser engine `granular` (cases A3): WGSL DEM and MLS-MPM granular kernels and their observables (T1 only) (DC-018-02, spec 018-web-cases).",
  "oneOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/output"
    }
  ],
  "$defs": {
    "input": {
      "type": "object",
      "description": "Request to the engine `granular`: envelope, function and its arguments in SI units.",
      "required": [
        "kind",
        "engine",
        "engine_version",
        "function",
        "args"
      ],
      "properties": {
        "kind": {
          "const": "input",
          "description": "Message kind: input for a request, output for a result (the discriminator of the root oneOf)."
        },
        "engine": {
          "const": "granular",
          "description": "Engine id of spec 018 section 7.1."
        },
        "engine_version": {
          "$ref": "#/$defs/semver",
          "description": "Engine version; the host rejects any version other than the loaded one."
        },
        "function": {
          "enum": [
            "dem_step",
            "dem_pile",
            "mpm_collapse"
          ],
          "description": "Function of the engine to evaluate."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "function": {
                "const": "dem_step"
              }
            },
            "required": [
              "function"
            ]
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "#/$defs/dem_step_args"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "function": {
                "const": "dem_pile"
              }
            },
            "required": [
              "function"
            ]
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "#/$defs/dem_pile_args"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "function": {
                "const": "mpm_collapse"
              }
            },
            "required": [
              "function"
            ]
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "#/$defs/mpm_collapse_args"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "output": {
      "type": "object",
      "description": "Result of the engine `granular`: envelope, function and its outputs in SI units.",
      "required": [
        "kind",
        "engine",
        "engine_version",
        "function",
        "result"
      ],
      "properties": {
        "kind": {
          "const": "output",
          "description": "Message kind: input for a request, output for a result (the discriminator of the root oneOf)."
        },
        "engine": {
          "const": "granular",
          "description": "Engine id of spec 018 section 7.1."
        },
        "engine_version": {
          "$ref": "#/$defs/semver",
          "description": "Engine version; the host rejects any version other than the loaded one."
        },
        "function": {
          "enum": [
            "dem_step",
            "dem_pile",
            "mpm_collapse"
          ],
          "description": "Function that produced the result."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "function": {
                "const": "dem_step"
              }
            },
            "required": [
              "function"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/dem_step_result"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "function": {
                "const": "dem_pile"
              }
            },
            "required": [
              "function"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/dem_pile_result"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "function": {
                "const": "mpm_collapse"
              }
            },
            "required": [
              "function"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/mpm_collapse_result"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "dem_step_args": {
      "type": "object",
      "additionalProperties": false,
      "description": "One DEM contact and integration step on a fixed configuration (per-kernel parity, FR-018-56).",
      "required": [
        "positions_m",
        "velocities_m_per_s",
        "radius_m",
        "density_kg_per_m3",
        "youngs_modulus_pa",
        "poisson_ratio",
        "restitution",
        "friction_static",
        "friction_rolling",
        "step_s",
        "contact_capacity"
      ],
      "properties": {
        "positions_m": {
          "type": "object",
          "additionalProperties": false,
          "description": "Particle positions.",
          "required": [
            "dtype",
            "shape",
            "byte_length"
          ],
          "properties": {
            "dtype": {
              "const": "float32",
              "description": "Element type of the buffer."
            },
            "shape": {
              "type": "object",
              "additionalProperties": false,
              "description": "Dimensions, outermost first.",
              "required": [
                "particles",
                "components"
              ],
              "properties": {
                "particles": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20000,
                  "description": "Particles (at most 2 x 10^4, spec 018 section 7.1)."
                },
                "components": {
                  "const": 3
                }
              }
            },
            "byte_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 240000,
              "description": "Bytes of the buffer; equals the product of the dimensions times the element size."
            }
          }
        },
        "velocities_m_per_s": {
          "type": "object",
          "additionalProperties": false,
          "description": "Particle velocities.",
          "required": [
            "dtype",
            "shape",
            "byte_length"
          ],
          "properties": {
            "dtype": {
              "const": "float32",
              "description": "Element type of the buffer."
            },
            "shape": {
              "type": "object",
              "additionalProperties": false,
              "description": "Dimensions, outermost first.",
              "required": [
                "particles",
                "components"
              ],
              "properties": {
                "particles": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20000,
                  "description": "Particles (at most 2 x 10^4, spec 018 section 7.1)."
                },
                "components": {
                  "const": 3
                }
              }
            },
            "byte_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 240000,
              "description": "Bytes of the buffer; equals the product of the dimensions times the element size."
            }
          }
        },
        "radius_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.5,
          "description": "Particle radius R (> 0)."
        },
        "density_kg_per_m3": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "description": "Particle density (> 0)."
        },
        "youngs_modulus_pa": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000000.0,
          "description": "Young's modulus E (> 0, FR-005-51)."
        },
        "poisson_ratio": {
          "type": "number",
          "exclusiveMinimum": -1,
          "exclusiveMaximum": 0.5,
          "description": "Poisson's ratio, open interval (-1, 0.5) (FR-005-51)."
        },
        "restitution": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Coefficient of restitution, (0, 1] (FR-005-51)."
        },
        "friction_static": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Static friction coefficient (>= 0)."
        },
        "friction_rolling": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Rolling friction coefficient (>= 0)."
        },
        "step_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.01,
          "description": "Time step (FR-005-08 stability bound checked by the engine)."
        },
        "contact_capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "description": "Contact-list capacity per particle (default 12, FR-005-06)."
        }
      }
    },
    "dem_step_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forces_n",
        "positions_m",
        "velocities_m_per_s",
        "contacts"
      ],
      "properties": {
        "forces_n": {
          "type": "object",
          "additionalProperties": false,
          "description": "Contact force on each particle.",
          "required": [
            "dtype",
            "shape",
            "byte_length"
          ],
          "properties": {
            "dtype": {
              "const": "float32",
              "description": "Element type of the buffer."
            },
            "shape": {
              "type": "object",
              "additionalProperties": false,
              "description": "Dimensions, outermost first.",
              "required": [
                "particles",
                "components"
              ],
              "properties": {
                "particles": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20000,
                  "description": "Particles (at most 2 x 10^4, spec 018 section 7.1)."
                },
                "components": {
                  "const": 3
                }
              }
            },
            "byte_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 240000,
              "description": "Bytes of the buffer; equals the product of the dimensions times the element size."
            }
          }
        },
        "positions_m": {
          "type": "object",
          "additionalProperties": false,
          "description": "Positions after one step.",
          "required": [
            "dtype",
            "shape",
            "byte_length"
          ],
          "properties": {
            "dtype": {
              "const": "float32",
              "description": "Element type of the buffer."
            },
            "shape": {
              "type": "object",
              "additionalProperties": false,
              "description": "Dimensions, outermost first.",
              "required": [
                "particles",
                "components"
              ],
              "properties": {
                "particles": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20000,
                  "description": "Particles (at most 2 x 10^4, spec 018 section 7.1)."
                },
                "components": {
                  "const": 3
                }
              }
            },
            "byte_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 240000,
              "description": "Bytes of the buffer; equals the product of the dimensions times the element size."
            }
          }
        },
        "velocities_m_per_s": {
          "type": "object",
          "additionalProperties": false,
          "description": "Velocities after one step.",
          "required": [
            "dtype",
            "shape",
            "byte_length"
          ],
          "properties": {
            "dtype": {
              "const": "float32",
              "description": "Element type of the buffer."
            },
            "shape": {
              "type": "object",
              "additionalProperties": false,
              "description": "Dimensions, outermost first.",
              "required": [
                "particles",
                "components"
              ],
              "properties": {
                "particles": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20000,
                  "description": "Particles (at most 2 x 10^4, spec 018 section 7.1)."
                },
                "components": {
                  "const": 3
                }
              }
            },
            "byte_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 240000,
              "description": "Bytes of the buffer; equals the product of the dimensions times the element size."
            }
          }
        },
        "contacts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 640000,
          "description": "Active contacts."
        }
      }
    },
    "dem_pile_args": {
      "type": "object",
      "additionalProperties": false,
      "description": "DEM pile twin scenario (FR-005-22).",
      "required": [
        "particle_count",
        "radius_m",
        "density_kg_per_m3",
        "youngs_modulus_pa",
        "poisson_ratio",
        "restitution",
        "friction_static",
        "friction_rolling",
        "method",
        "step_s",
        "steps",
        "seed"
      ],
      "properties": {
        "particle_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000,
          "description": "Particles (at most 2 x 10^4, spec 018 section 7.1)."
        },
        "radius_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.5,
          "description": "Particle radius R (> 0)."
        },
        "density_kg_per_m3": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "description": "Particle density (> 0)."
        },
        "youngs_modulus_pa": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000000.0,
          "description": "Young's modulus E (> 0, FR-005-51)."
        },
        "poisson_ratio": {
          "type": "number",
          "exclusiveMinimum": -1,
          "exclusiveMaximum": 0.5,
          "description": "Poisson's ratio, open interval (-1, 0.5) (FR-005-51)."
        },
        "restitution": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Coefficient of restitution, (0, 1] (FR-005-51)."
        },
        "friction_static": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Static friction coefficient (>= 0)."
        },
        "friction_rolling": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Rolling friction coefficient (>= 0)."
        },
        "method": {
          "enum": [
            "lifted-cylinder",
            "poured-cone"
          ],
          "description": "Repose method (FR-005-12)."
        },
        "step_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.01
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Seed of the engine's generator; an integer exactly representable in a JavaScript number."
        }
      }
    },
    "dem_pile_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repose_angle_rad",
        "particle_count",
        "mass_drift_fraction",
        "steps"
      ],
      "properties": {
        "repose_angle_rad": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.5707963267948966,
          "description": "Angle of repose (FR-005-13)."
        },
        "particle_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000,
          "description": "Particles (at most 2 x 10^4, spec 018 section 7.1)."
        },
        "mass_drift_fraction": {
          "type": "number",
          "minimum": 0,
          "description": "Relative total-mass drift (< 0.005 for parity, FR-018-56)."
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "mpm_collapse_args": {
      "type": "object",
      "additionalProperties": false,
      "description": "2-D MLS-MPM column collapse twin scenario (FR-005-17, FR-005-22).",
      "required": [
        "particle_count",
        "aspect_ratio",
        "column_width_m",
        "friction_angle_rad",
        "density_kg_per_m3",
        "youngs_modulus_pa",
        "poisson_ratio",
        "step_s",
        "steps"
      ],
      "properties": {
        "particle_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000,
          "description": "Particles (at most 2 x 10^4, spec 018 section 7.1)."
        },
        "aspect_ratio": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 4,
          "description": "Column aspect ratio a = H_i / L_i (FR-005-18)."
        },
        "column_width_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100,
          "description": "Initial column width L_i."
        },
        "friction_angle_rad": {
          "type": "number",
          "minimum": 0.3490658503988659,
          "maximum": 0.6981317007977318,
          "description": "Drucker-Prager friction angle, 20 to 40 degrees."
        },
        "density_kg_per_m3": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 20000
        },
        "youngs_modulus_pa": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000000.0
        },
        "poisson_ratio": {
          "type": "number",
          "exclusiveMinimum": -1,
          "exclusiveMaximum": 0.5
        },
        "step_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.01
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "mpm_collapse_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runout_m",
        "final_height_m",
        "mass_drift_fraction",
        "steps"
      ],
      "properties": {
        "runout_m": {
          "type": "number",
          "minimum": 0,
          "description": "Run-out per side L_inf (FR-005-18)."
        },
        "final_height_m": {
          "type": "number",
          "minimum": 0
        },
        "mass_drift_fraction": {
          "type": "number",
          "minimum": 0
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "semver": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/replay-shard.schema.json",
  "title": "PitStudio replay shard header and replay manifest",
  "description": "Replay shard headers and replay manifests written by st50_physics, s60_export and studio publish (DC-018-03, spec 018-web-cases; also DC-005-04, spec 005-physics).",
  "oneOf": [
    {
      "$ref": "#/$defs/shard_header"
    },
    {
      "$ref": "#/$defs/replay_manifest"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "relpath": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?(/[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?){0,15}$"
    },
    "slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$"
    },
    "schema_version": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^1\\.[0-9]+$"
    },
    "code_type": {
      "enum": [
        "int16",
        "uint16"
      ],
      "description": "integer type of the quantised codes; decoding maps the 65,536 codes affinely onto [min, max] of each channel"
    },
    "fps": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 240,
      "description": "frames per second"
    },
    "bbox_m": {
      "type": "object",
      "description": "axis-aligned bounding box in metres (x, y, z)",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "max": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "frame_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "count"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        }
      }
    },
    "code_range": {
      "type": "object",
      "description": "smallest and largest code present in the payload; the reader rejects a shard with a code outside it (FR-018-45)",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 65535
        },
        "max": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 65535
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "unit",
        "min",
        "max"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "unit": {
          "enum": [
            "m",
            "m/s",
            "m/s2",
            "rad",
            "s",
            "1",
            "ug/m3",
            "kg/m3",
            "kg/m2",
            "Pa"
          ]
        },
        "min": {
          "type": "number",
          "description": "value of the lowest code, in the channel unit"
        },
        "max": {
          "type": "number",
          "description": "value of the highest code, in the channel unit"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "name": {
                "enum": [
                  "x",
                  "y",
                  "z"
                ]
              }
            },
            "required": [
              "name"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "const": "m"
              }
            }
          }
        }
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relpath",
          "description": "payload file, relative to the header's folder"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000,
          "description": "payload size; shards and tiles are at most 10 MB (10^7 bytes)"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "shard_header": {
      "type": "object",
      "description": "JSON header of one shard or field tile (DC-018-03)",
      "additionalProperties": false,
      "required": [
        "document",
        "schema_version",
        "kind",
        "encoding",
        "fps",
        "frames",
        "items",
        "channels",
        "bbox_m",
        "payload"
      ],
      "properties": {
        "$schema": {
          "type": "string",
          "maxLength": 200,
          "description": "editor hint; ignored by consumers"
        },
        "document": {
          "const": "replay-shard-header"
        },
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "kind": {
          "enum": [
            "pose",
            "particle",
            "point",
            "field"
          ]
        },
        "encoding": {
          "enum": [
            "raw16",
            "png16",
            "float32"
          ],
          "description": "raw16: little-endian 16-bit codes in frame, item, channel order; png16: 16-bit greyscale PNG tile; float32: little-endian Float32 tile"
        },
        "code_type": {
          "$ref": "#/$defs/code_type"
        },
        "code_range": {
          "$ref": "#/$defs/code_range"
        },
        "fps": {
          "$ref": "#/$defs/fps"
        },
        "frames": {
          "$ref": "#/$defs/frame_range"
        },
        "items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000000,
          "description": "poses, particles, points or cells per frame"
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/channel"
          }
        },
        "bbox_m": {
          "$ref": "#/$defs/bbox_m"
        },
        "grid": {
          "type": "object",
          "description": "tile size in cells (field tiles only)",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          }
        },
        "payload": {
          "$ref": "#/$defs/payload"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "pose",
                  "particle",
                  "point"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "encoding": {
                "const": "raw16"
              }
            },
            "not": {
              "required": [
                "grid"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "field"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "grid"
            ],
            "properties": {
              "encoding": {
                "enum": [
                  "png16",
                  "float32"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "encoding": {
                "enum": [
                  "raw16",
                  "png16"
                ]
              }
            },
            "required": [
              "encoding"
            ]
          },
          "then": {
            "required": [
              "code_type",
              "code_range"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "encoding": {
                "const": "float32"
              }
            },
            "required": [
              "encoding"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "code_type"
                  ]
                },
                {
                  "required": [
                    "code_range"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "encoding": {
                "const": "png16"
              }
            },
            "required": [
              "encoding"
            ]
          },
          "then": {
            "properties": {
              "code_type": {
                "const": "uint16"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code_type": {
                "const": "int16"
              }
            },
            "required": [
              "code_type"
            ]
          },
          "then": {
            "properties": {
              "code_range": {
                "properties": {
                  "min": {
                    "maximum": 32767
                  },
                  "max": {
                    "maximum": 32767
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code_type": {
                "const": "uint16"
              }
            },
            "required": [
              "code_type"
            ]
          },
          "then": {
            "properties": {
              "code_range": {
                "properties": {
                  "min": {
                    "minimum": 0
                  },
                  "max": {
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      ]
    },
    "shard_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "payload",
        "bytes",
        "sha256",
        "frames"
      ],
      "properties": {
        "header": {
          "$ref": "#/$defs/relpath",
          "description": "shard header JSON, relative to the manifest's folder"
        },
        "payload": {
          "$ref": "#/$defs/relpath",
          "description": "shard payload, relative to the manifest's folder"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "sha256": {
          "$ref": "#/$defs/sha256",
          "description": "SHA-256 of the payload bytes"
        },
        "frames": {
          "$ref": "#/$defs/frame_range"
        }
      }
    },
    "replay_manifest": {
      "type": "object",
      "description": "replay manifest listing the shards of one replay (FR-005-45)",
      "additionalProperties": false,
      "required": [
        "document",
        "schema_version",
        "kind",
        "units",
        "bbox_m",
        "fps",
        "frames",
        "items",
        "code_type",
        "solver",
        "seed",
        "shards"
      ],
      "properties": {
        "$schema": {
          "type": "string",
          "maxLength": 200,
          "description": "editor hint; ignored by consumers"
        },
        "document": {
          "const": "replay-manifest"
        },
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "kind": {
          "enum": [
            "particle",
            "pose",
            "point"
          ]
        },
        "units": {
          "const": "m",
          "description": "length unit of positions and of the bounding box"
        },
        "bbox_m": {
          "$ref": "#/$defs/bbox_m"
        },
        "fps": {
          "$ref": "#/$defs/fps"
        },
        "frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000,
          "description": "frame count"
        },
        "items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1666666,
          "description": "particle (or pose, point) count per frame; one frame of three 16-bit channels fits one shard"
        },
        "code_type": {
          "$ref": "#/$defs/code_type"
        },
        "solver": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/slug"
            },
            "version": {
              "$ref": "#/$defs/version"
            }
          }
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "shards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/shard_entry"
          }
        }
      }
    }
  }
}

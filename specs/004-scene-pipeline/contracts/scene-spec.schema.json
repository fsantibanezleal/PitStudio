{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/scene-spec.schema.json",
  "title": "Scene specification (SceneSpec)",
  "description": "Scene specification read from the recipe params of st10_terrain to st45_validate and the export stage (DC-004-01, spec 004-scene-pipeline). It is a recipe params object: keys follow param_key, nesting depth <= 4 including the root, no $schema member.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case",
    "seed",
    "site",
    "terrain",
    "design",
    "assets",
    "parts",
    "fleet",
    "people_count",
    "materials",
    "labels",
    "variants"
  ],
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/schema_version"
    },
    "case": {
      "$ref": "#/$defs/case_id"
    },
    "seed": {
      "type": "integer",
      "description": "scene master seed, 0 ... 2^63-1",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "site": {
      "$ref": "#/$defs/site"
    },
    "terrain": {
      "$ref": "#/$defs/terrain"
    },
    "design": {
      "$ref": "#/$defs/design"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "maxItems": 32
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/part"
      },
      "maxItems": 512
    },
    "fleet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fleet_entry"
      },
      "maxItems": 32
    },
    "people_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/material"
      },
      "maxItems": 64
    },
    "labels": {
      "$ref": "#/$defs/labels"
    },
    "variants": {
      "$ref": "#/$defs/variants"
    },
    "validation": {
      "$ref": "#/$defs/validation"
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "case_id": {
      "enum": [
        "A1",
        "A2",
        "A3",
        "B1",
        "B2",
        "C1",
        "C2",
        "C3",
        "D1",
        "D2",
        "E1",
        "E2"
      ]
    },
    "spdx_id": {
      "enum": [
        "LicenseRef-USGov-PD",
        "CC0-1.0",
        "DL-DE-ZERO-2.0",
        "CC-BY-4.0",
        "LicenseRef-Copernicus-CLMS",
        "CC-BY-SA-3.0",
        "CC-BY-SA-4.0",
        "Apache-2.0",
        "MIT",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "MPL-2.0",
        "LGPL-2.1-or-later",
        "LicenseRef-TOST-1.0",
        "LicenseRef-NVIDIA-Open-Model",
        "LicenseRef-NVIDIA-SLA",
        "LicenseRef-NvidiaProprietary",
        "LicenseRef-NVIDIA-Omniverse",
        "LicenseRef-TensorRT-SLA",
        "LicenseRef-TensorRT-RTX-SLA"
      ]
    },
    "schema_version": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^1\\.[0-9]+$"
    },
    "class_label": {
      "description": "closed class-label vocabulary (SemanticsLabelsAPI `class`, FR-004-25)",
      "enum": [
        "terrain",
        "bench",
        "berm",
        "ramp",
        "windrow",
        "haul_road",
        "haul_truck",
        "shovel",
        "excavator",
        "wheel_loader",
        "water_truck",
        "light_vehicle",
        "crusher",
        "person",
        "boulder"
      ]
    },
    "machine_class": {
      "description": "class labels of the machines st30_assets builds (FR-004-24)",
      "enum": [
        "haul_truck",
        "shovel",
        "excavator",
        "wheel_loader",
        "water_truck",
        "light_vehicle",
        "crusher"
      ]
    },
    "part_label": {
      "description": "closed part-label vocabulary for articulated sub-parts (FR-004-25)",
      "enum": [
        "chassis",
        "cab",
        "dump_body",
        "wheel",
        "axle",
        "track",
        "undercarriage",
        "house",
        "boom",
        "stick",
        "bucket",
        "dipper",
        "lift_arm",
        "front_frame",
        "rear_frame",
        "tank",
        "spray_bar",
        "hopper"
      ]
    },
    "scene_source_id": {
      "description": "data/sources.yaml ids a scene may use (closed list, FR-004-40)",
      "enum": [
        "usgs-3dep-bingham",
        "ot-mckinley-2023",
        "nrw-hambach-dgm1",
        "tang-werner-footprint",
        "maus-v2",
        "polyhaven",
        "ambientcg",
        "makehuman-exports"
      ]
    },
    "variant_name": {
      "description": "a free variant name (pushback, scenario); a USD identifier",
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "time_of_day": {
      "enum": [
        "dawn",
        "morning",
        "noon",
        "afternoon",
        "dusk",
        "night"
      ]
    },
    "weather": {
      "enum": [
        "clear",
        "overcast",
        "rain",
        "dust",
        "fog"
      ]
    },
    "lod_name": {
      "description": "name of a `lod` variant; one per terrain LOD (FR-004-08)",
      "enum": [
        "lod0",
        "lod1",
        "lod2"
      ]
    },
    "lod_index": {
      "description": "terrain level of detail (FR-004-06: LOD 0-2)",
      "enum": [
        0,
        1,
        2
      ]
    },
    "site_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "epsg",
        "easting_m",
        "northing_m",
        "z0_m"
      ],
      "properties": {
        "epsg": {
          "description": "EPSG code of the UTM zone of the site (NAD83(2011), ETRS89, NAD83, WGS 84 zones)",
          "type": "integer",
          "anyOf": [
            {
              "minimum": 6328,
              "maximum": 6348
            },
            {
              "minimum": 25828,
              "maximum": 25838
            },
            {
              "minimum": 26901,
              "maximum": 26923
            },
            {
              "minimum": 32601,
              "maximum": 32660
            },
            {
              "minimum": 32701,
              "maximum": 32760
            }
          ]
        },
        "easting_m": {
          "type": "number",
          "minimum": 100000,
          "maximum": 900000
        },
        "northing_m": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000000
        },
        "z0_m": {
          "type": "number",
          "description": "origin elevation z0 in the vertical datum of the inputs, m",
          "minimum": -500,
          "maximum": 9000
        }
      },
      "description": "site origin of the site-local frame (FR-004-02)"
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "origin",
        "polygon_sources"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ,.'-]{0,127}$"
        },
        "origin": {
          "$ref": "#/$defs/site_origin"
        },
        "polygon_sources": {
          "type": "array",
          "description": "mine-polygon datasets for FR-004-15",
          "items": {
            "enum": [
              "tang-werner-footprint",
              "maus-v2"
            ]
          },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        }
      }
    },
    "terrain_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "project",
        "epoch",
        "optional"
      ],
      "properties": {
        "id": {
          "enum": [
            "usgs-3dep-bingham",
            "ot-mckinley-2023",
            "nrw-hambach-dgm1"
          ]
        },
        "kind": {
          "enum": [
            "dem",
            "laz"
          ]
        },
        "project": {
          "type": "string",
          "description": "3DEP or survey project name (one project per terrain grid)",
          "minLength": 1,
          "maxLength": 128
        },
        "epoch": {
          "type": "integer",
          "description": "survey year",
          "minimum": 1990,
          "maximum": 2100
        },
        "optional": {
          "type": "boolean",
          "description": "FR-004-09: optional sources may end 'not run'"
        }
      }
    },
    "lod_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lod",
        "max_error_m",
        "skirt_depth_m"
      ],
      "properties": {
        "lod": {
          "$ref": "#/$defs/lod_index"
        },
        "max_error_m": {
          "type": "number",
          "description": "RTIN vertical error bound (FR-004-06, P-004-01 domain 0.05-8 m)",
          "minimum": 0.05,
          "maximum": 8
        },
        "skirt_depth_m": {
          "type": "number",
          "description": "skirt depth (FR-004-07; default 2 x max_error)",
          "exclusiveMinimum": 0,
          "maximum": 16
        }
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "from_epsg",
        "to_epsg"
      ],
      "properties": {
        "component": {
          "enum": [
            "horizontal",
            "vertical"
          ]
        },
        "from_epsg": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 32767
        },
        "to_epsg": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 32767
        }
      },
      "description": "a CRS or datum transformation the recipe declares (FR-004-11)"
    },
    "terrain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "cell_size_m",
        "max_fill_cells",
        "max_nodata_frac",
        "max_cells",
        "aoi_xy_m",
        "lods"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/terrain_source"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "cell_size_m": {
          "type": "number",
          "description": "grid cell size (FR-004-04; default 1.0 m)",
          "minimum": 0.25,
          "maximum": 10
        },
        "max_fill_cells": {
          "type": "integer",
          "description": "largest hole filled (FR-004-05; default and cap 16)",
          "minimum": 0,
          "maximum": 16
        },
        "max_nodata_frac": {
          "type": "number",
          "description": "largest nodata fraction after filling (FR-004-12; default 0.05)",
          "minimum": 0,
          "maximum": 0.05
        },
        "max_cells": {
          "type": "integer",
          "description": "grid cell cap (FR-004-13; default 1.0e8)",
          "minimum": 1,
          "maximum": 100000000
        },
        "aoi_xy_m": {
          "type": "array",
          "description": "AOI polygon vertices [x, y] in the site frame, m; >= 3 vertices (FR-004-13)",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "description": "site-frame coordinate, m (FR-004-02: |offset| <= 1.0e5 m horizontally)",
              "minimum": -100000,
              "maximum": 100000
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 3,
          "maxItems": 1024
        },
        "lods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lod_spec"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "transformations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transformation"
          },
          "maxItems": 8
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outline_source",
        "floor_z_m",
        "bench_height_m",
        "face_angle_deg",
        "berm_width_m",
        "ramp_grade_pct",
        "ramp_width_m",
        "windrow_height_m"
      ],
      "properties": {
        "outline_source": {
          "enum": [
            "rim-contour",
            "upstream-shell"
          ]
        },
        "rim_z_m": {
          "type": "number",
          "description": "site-frame elevation, m (FR-004-02: |offset| <= 5.0e3 m vertically)",
          "minimum": -5000,
          "maximum": 5000
        },
        "floor_z_m": {
          "type": "number",
          "description": "site-frame elevation, m (FR-004-02: |offset| <= 5.0e3 m vertically)",
          "minimum": -5000,
          "maximum": 5000
        },
        "bench_height_m": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "code_min",
            "code_max",
            "citation",
            "verification"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 5,
              "maximum": 30
            },
            "code_min": {
              "type": "number",
              "minimum": 5,
              "maximum": 30
            },
            "code_max": {
              "type": "number",
              "minimum": 5,
              "maximum": 30
            },
            "citation": {
              "type": "string",
              "description": "source of the value (document, table or page); at most 256 characters (FR-004-40)",
              "minLength": 1,
              "maxLength": 256
            },
            "verification": {
              "enum": [
                "verified",
                "unverified"
              ]
            }
          },
          "description": "bench height H, m (hard domain [5, 30])"
        },
        "face_angle_deg": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "code_min",
            "code_max",
            "citation",
            "verification"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 40,
              "maximum": 85
            },
            "code_min": {
              "type": "number",
              "minimum": 40,
              "maximum": 85
            },
            "code_max": {
              "type": "number",
              "minimum": 40,
              "maximum": 85
            },
            "citation": {
              "type": "string",
              "description": "source of the value (document, table or page); at most 256 characters (FR-004-40)",
              "minLength": 1,
              "maxLength": 256
            },
            "verification": {
              "enum": [
                "verified",
                "unverified"
              ]
            }
          },
          "description": "bench face angle alpha, degrees (hard domain [40, 85])"
        },
        "berm_width_m": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "code_min",
            "code_max",
            "citation",
            "verification"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 3,
              "maximum": 60
            },
            "code_min": {
              "type": "number",
              "minimum": 3,
              "maximum": 60
            },
            "code_max": {
              "type": "number",
              "minimum": 3,
              "maximum": 60
            },
            "citation": {
              "type": "string",
              "description": "source of the value (document, table or page); at most 256 characters (FR-004-40)",
              "minLength": 1,
              "maxLength": 256
            },
            "verification": {
              "enum": [
                "verified",
                "unverified"
              ]
            }
          },
          "description": "berm width b, m (hard domain [3, 60])"
        },
        "ramp_grade_pct": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "code_min",
            "code_max",
            "citation",
            "verification"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 15
            },
            "code_min": {
              "type": "number",
              "minimum": 0,
              "maximum": 15
            },
            "code_max": {
              "type": "number",
              "minimum": 0,
              "maximum": 15
            },
            "citation": {
              "type": "string",
              "description": "source of the value (document, table or page); at most 256 characters (FR-004-40)",
              "minLength": 1,
              "maxLength": 256
            },
            "verification": {
              "enum": [
                "verified",
                "unverified"
              ]
            }
          },
          "description": "ramp grade g, percent rise over run (hard domain [0, 15])"
        },
        "ramp_width_m": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "code_min",
            "code_max",
            "citation",
            "verification"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 8,
              "maximum": 60
            },
            "code_min": {
              "type": "number",
              "minimum": 8,
              "maximum": 60
            },
            "code_max": {
              "type": "number",
              "minimum": 8,
              "maximum": 60
            },
            "citation": {
              "type": "string",
              "description": "source of the value (document, table or page); at most 256 characters (FR-004-40)",
              "minLength": 1,
              "maxLength": 256
            },
            "verification": {
              "enum": [
                "verified",
                "unverified"
              ]
            }
          },
          "description": "ramp width W, m (hard domain [8, 60])"
        },
        "windrow_height_m": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "code_min",
            "code_max",
            "citation",
            "verification"
          ],
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 5
            },
            "code_min": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 5
            },
            "code_max": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 5
            },
            "citation": {
              "type": "string",
              "description": "source of the value (document, table or page); at most 256 characters (FR-004-40)",
              "minLength": 1,
              "maxLength": 256
            },
            "verification": {
              "enum": [
                "verified",
                "unverified"
              ]
            }
          },
          "description": "windrow height, m (hard domain (0, 5])"
        }
      },
      "description": "design parameters with their design-code ranges and citations (FR-004-16 ... FR-004-22)",
      "allOf": [
        {
          "if": {
            "properties": {
              "outline_source": {
                "const": "rim-contour"
              }
            },
            "required": [
              "outline_source"
            ]
          },
          "then": {
            "required": [
              "rim_z_m"
            ]
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class_label",
        "length_m",
        "width_m",
        "height_m",
        "mass_kg",
        "dimensions_citation",
        "mass_citation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "class_label": {
          "$ref": "#/$defs/machine_class"
        },
        "length_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 50
        },
        "width_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 50
        },
        "height_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 50
        },
        "mass_kg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000000
        },
        "mid_axle_height_m": {
          "type": "number",
          "description": "mid-axle height (30 CFR 56.9300(b), FR-004-18)",
          "exclusiveMinimum": 0,
          "maximum": 5
        },
        "dimensions_citation": {
          "type": "string",
          "description": "source of the value (document, table or page); at most 256 characters (FR-004-40)",
          "minLength": 1,
          "maxLength": 256
        },
        "mass_citation": {
          "type": "string",
          "description": "source of the value (document, table or page); at most 256 characters (FR-004-40)",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "description": "one machine model (FR-004-24, FR-004-27)",
      "allOf": [
        {
          "if": {
            "properties": {
              "class_label": {
                "enum": [
                  "haul_truck",
                  "wheel_loader",
                  "water_truck",
                  "light_vehicle"
                ]
              }
            },
            "required": [
              "class_label"
            ]
          },
          "then": {
            "required": [
              "mid_axle_height_m"
            ]
          }
        }
      ]
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset",
        "id",
        "part",
        "parent",
        "mass_kg",
        "length_m",
        "width_m",
        "height_m",
        "citation"
      ],
      "properties": {
        "asset": {
          "$ref": "#/$defs/slug"
        },
        "id": {
          "$ref": "#/$defs/slug"
        },
        "part": {
          "$ref": "#/$defs/part_label"
        },
        "parent": {
          "description": "parent part id; null for the articulation root",
          "anyOf": [
            {
              "$ref": "#/$defs/slug"
            },
            {
              "const": null
            }
          ]
        },
        "joint": {
          "enum": [
            "revolute",
            "prismatic"
          ]
        },
        "axis": {
          "enum": [
            "X",
            "Y",
            "Z"
          ]
        },
        "lower_deg": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "upper_deg": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "lower_m": {
          "type": "number",
          "minimum": -50,
          "maximum": 50
        },
        "upper_m": {
          "type": "number",
          "minimum": -50,
          "maximum": 50
        },
        "mass_kg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000000
        },
        "length_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 50
        },
        "width_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 50
        },
        "height_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 50
        },
        "exclude_from_articulation": {
          "type": "boolean",
          "description": "true for a joint that closes a kinematic loop (FR-004-24)"
        },
        "citation": {
          "type": "string",
          "description": "source of the value (document, table or page); at most 256 characters (FR-004-40)",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "description": "one rigid body of an asset and the joint to its parent (FR-004-24, FR-004-27)",
      "allOf": [
        {
          "if": {
            "properties": {
              "parent": {
                "const": null
              }
            },
            "required": [
              "parent"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "joint"
                  ]
                },
                {
                  "required": [
                    "axis"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "joint",
              "axis"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "joint": {
                "const": "revolute"
              }
            },
            "required": [
              "joint"
            ]
          },
          "then": {
            "required": [
              "lower_deg",
              "upper_deg"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "lower_m"
                  ]
                },
                {
                  "required": [
                    "upper_m"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "joint": {
                "const": "prismatic"
              }
            },
            "required": [
              "joint"
            ]
          },
          "then": {
            "required": [
              "lower_m",
              "upper_m"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "lower_deg"
                  ]
                },
                {
                  "required": [
                    "upper_deg"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "fleet_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset",
        "count"
      ],
      "properties": {
        "asset": {
          "$ref": "#/$defs/slug"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "spdx"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "source": {
          "enum": [
            "polyhaven",
            "ambientcg",
            null
          ]
        },
        "spdx": {
          "$ref": "#/$defs/spdx_id",
          "enum": [
            "CC0-1.0",
            "CC-BY-4.0"
          ]
        }
      },
      "description": "a UsdPreviewSurface material: CC0 textures from a source, or our own (CC-BY-4.0) (FR-004-26)",
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": null
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "spdx": {
                "const": "CC-BY-4.0"
              }
            }
          },
          "else": {
            "properties": {
              "spdx": {
                "const": "CC0-1.0"
              }
            }
          }
        }
      ]
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classes",
        "parts"
      ],
      "properties": {
        "classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/class_label"
          },
          "minItems": 1,
          "maxItems": 15,
          "uniqueItems": true
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part_label"
          },
          "maxItems": 18,
          "uniqueItems": true
        }
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pushback",
        "scenario",
        "time_of_day",
        "weather",
        "lod"
      ],
      "properties": {
        "pushback": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variant_name"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "scenario": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variant_name"
          },
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "time_of_day": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/time_of_day"
          },
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true
        },
        "weather": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/weather"
          },
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true
        },
        "lod": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lod_name"
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        }
      },
      "description": "variant names per variant set; the first name is the default selection (FR-004-29)"
    },
    "rule_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "reason"
      ],
      "properties": {
        "rule": {
          "$ref": "#/$defs/rule_id"
        },
        "reason": {
          "type": "string",
          "minLength": 10,
          "maxLength": 256
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "waivers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/waiver"
          },
          "maxItems": 32
        }
      }
    }
  }
}

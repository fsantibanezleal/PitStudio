  "not_schema_checkable": [
    {
      "schema": "sensor-recipe.schema.json",
      "class": "non-finite number (NaN, Infinity)",
      "by": "loader",
      "rule": "FR-001-05"
    },
    {
      "schema": "sensor-recipe.schema.json",
      "class": "YAML alias, anchor, tag, duplicate key or second document",
      "by": "loader",
      "rule": "FR-001-06"
    },
    {
      "schema": "sensor-recipe.schema.json",
      "class": "e_min < e_max, a_min < a_max and min_range_m < max_range_m",
      "by": "checker",
      "rule": "FR-013-04"
    },
    {
      "schema": "sensor-recipe.schema.json",
      "class": "poses or extinction-field path outside the stage's declared inputs; Windows device-name segment",
      "by": "checker",
      "rule": "FR-013-04"
    },
    {
      "schema": "sensor-recipe.schema.json",
      "class": "sensor ids unique within the block",
      "by": "checker",
      "rule": "FR-013-04"
    },
    {
      "schema": "sensor-recipe.schema.json",
      "class": "lidar configuration listed `pass` in studio/rtx/lidar-envelope.json for the locked ovrtx and ovstage versions",
      "by": "checker",
      "rule": "FR-013-05"

# Open-source runner image (FR-002-07): the runner and contract tests that need no GPU, on Linux.
# Both base images are pinned by SHA-256 digest (read from the registries on 2026-10-11); uv comes from its own pinned image.
FROM ghcr.io/astral-sh/uv:0.12.22@sha256:f513a91fc62fe7c17567eee97230dd198e43edb8a9fbecca843714a4358fe1bc AS uv

FROM python:3.14-slim-trixie@sha256:a2b82f3c48559aa0a8446d9af49826b6e2b2016f4cd2afabfe6013ec53729170
COPY --from=uv /uv /uvx /bin/
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never PATH="/app/.venv/bin:$PATH"
# git: the stage tests build throw-away repositories, and one locked dependency is a git source
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . /app
RUN uv sync --locked --all-groups --extra runner --extra api
CMD ["pytest", "-m", "not gpu", "tests/unit", "tests/contract", "tests/property"]

    "/runs/{run_id}/artefacts/{artefact_id}": {
      "get": {
        "summary": "Artefact",
        "operationId": "artefact_runs__run_id__artefacts__artefact_id__get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]{0,47}$",
              "title": "Run Id"
            }
          },
          {
            "name": "artefact_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 96,
              "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$",
              "title": "Artefact Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "the bytes",
            "content": {
              "application/json": {
                "schema": {}
              },
              "*/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "partial content",
            "content": {
              "*/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {

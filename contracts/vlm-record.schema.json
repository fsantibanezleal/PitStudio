                  },
                  "revision": {
                    "pattern": "^9ce19a1[0-9a-f]{33}$"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "licence_class": {
                "const": "own"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "arm": {
                "const": "qwen-base"
              }
            },
            "required": [
              "arm"
            ]
          },
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "model": {
                    "const": "Qwen/Qwen3-VL-2B-Instruct"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "arm": {
                "const": "cosmos-q8_0"
              }
            },
            "required": [
              "arm"
            ]
          },
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "quantisation": {
                    "const": "q8_0"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "arm": {
                "const": "cosmos-bf16"
              }
            },
            "required": [
              "arm"
            ]
          },
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "quantisation": {
                    "const": "bf16"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "presentation": {
                "const": "pair-calibrated-first"
              }
            },
            "required": [
              "presentation"
            ]
          },
          "then": {
            "properties": {
              "truth": {
                "const": "first"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "presentation": {
                "const": "pair-corrupted-first"
              }
            },
            "required": [
              "presentation"
            ]
          },
          "then": {
            "properties": {
              "truth": {
                "const": "second"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "presentation": {
                "const": "single-calibrated"
              }
            },
            "required": [
              "presentation"
            ]
          },
          "then": {
            "properties": {
              "truth": {
                "const": "yes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "presentation": {
                "const": "single-corrupted"
              }
            },
            "required": [
              "presentation"
            ]
          },
          "then": {
            "properties": {
              "truth": {
                "const": "no"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "presentation": {
                "enum": [
                  "pair-calibrated-first",
                  "pair-corrupted-first"
                ]
              }
            },
            "required": [
              "presentation"
            ]
          },
          "then": {
            "properties": {
              "frames": {
                "minItems": 2
              },
              "parsed": {
                "enum": [
                  "first",
                  "second",
                  "unparseable"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "frames": {
                "maxItems": 1
              },
              "parsed": {
                "enum": [
                  "yes",
                  "no",
                  "unparseable"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provenance": {
                "properties": {
                  "quantisation": {
                    "const": "q8_0"
                  }
                },
                "required": [
                  "quantisation"
                ]
              }
            },
            "required": [
              "provenance"
            ]
          },
          "then": {
            "properties": {
              "input_mode": {
                "const": "frame-list-approximation"
              }
            }
          },
          "else": {
            "properties": {
              "input_mode": {
                "const": "native-video"
              }
            }
          }
        }
      ]
    },
    "class_set": {
      "type": "array",
      "items": {
        "$ref": "frame-state.schema.json#/$defs/object_class"
      },
      "maxItems": 5,
      "uniqueItems": true
    },

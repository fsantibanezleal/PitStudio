{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/accel-table.schema.json",
  "title": "Acceleration web table",
  "description": "Acceleration table baked by s64_bench from the publishable bench records, with its one-machine caption and every rejected, build-failed or not-run cell (DC-016-05, spec 016-export-acceleration).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 200
    },
    "schema_version": {
      "$ref": "#/$defs/schema_version"
    },
    "generated": {
      "$ref": "#/$defs/date"
    },
    "git_sha": {
      "$ref": "#/$defs/git_sha"
    },
    "caption": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^measured on one RTX 5000 Ada Laptop GPU \\(power-limited\\), Windows 11, [0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]), [0-9a-f]{7,40} — not a general benchmark$"
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gpu_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "driver": {
          "$ref": "#/$defs/driver"
        }
      },
      "required": [
        "gpu_name",
        "driver"
      ]
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      },
      "maxItems": 512,
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "generated",
    "git_sha",
    "caption",
    "conditions",
    "rows"
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "git_sha": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "date": {
      "type": "string",
      "maxLength": 10,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$"
    },
    "driver": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]+(\\.[0-9]+)+$"
    },
    "schema_version": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^1\\.[0-9]+$"
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "$ref": "#/$defs/slug"
        },
        "backend": {
          "enum": [
            "pytorch",
            "ort-cpu",
            "ort-cuda",
            "ort-tensorrt",
            "tensorrt"
          ]
        },
        "precision": {
          "$ref": "bench-record.schema.json#/$defs/precision"
        },
        "tensorrt_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/version"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "bench-record.schema.json#/$defs/status"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "performance": {
          "const": "public"
        },
        "latency": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "bench-record.schema.json#/$defs/latency_entry"
              },
              "maxItems": 4,
              "minItems": 4
            },
            {
              "type": "null"
            }
          ]
        },
        "throughput": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "bench-record.schema.json#/$defs/throughput_entry"
              },
              "maxItems": 4,
              "minItems": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "joules_per_inference": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "vram_peak_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "thermal_slowdown": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "camera_streams": {
          "anyOf": [
            {
              "$ref": "bench-record.schema.json#/$defs/camera_streams"
            },
            {
              "type": "null"
            }
          ]
        },
        "parity": {
          "anyOf": [
            {
              "$ref": "bench-record.schema.json#/$defs/parity"
            },
            {
              "type": "null"
            }
          ]
        },
        "power_limit_enforced_w": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "power_source": {
          "enum": [
            "ac",
            "battery"
          ]
        },
        "tensorrt_licence_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "model",
        "backend",
        "precision",
        "tensorrt_version",
        "status",
        "performance",
        "latency",
        "throughput",
        "joules_per_inference",
        "vram_peak_bytes",
        "thermal_slowdown",
        "camera_streams",
        "parity",
        "power_limit_enforced_w",
        "power_source",
        "tensorrt_licence_sha256"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "rejected",
                  "build-failed",
                  "not_run"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "build-failed",
                  "not_run"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "latency": {
                "const": null
              },
              "throughput": {
                "const": null
              },
              "joules_per_inference": {
                "const": null
              },
              "vram_peak_bytes": {
                "const": null
              },
              "thermal_slowdown": {
                "const": null
              },
              "camera_streams": {
                "const": null
              },
              "parity": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "pass"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "parity": {
                "not": {
                  "const": null
                },
                "properties": {
                  "verdict": {
                    "const": "pass"
                  }
                },
                "required": [
                  "verdict"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "enum": [
                  "tensorrt",
                  "ort-tensorrt"
                ]
              },
              "status": {
                "enum": [
                  "pass",
                  "rejected"
                ]
              }
            },
            "required": [
              "backend",
              "status"
            ]
          },
          "then": {
            "properties": {
              "tensorrt_licence_sha256": {
                "const": "c86915fd95bbefbdda3135aace3e6ad6b4612846dcbdbc5d2f5a38b139dd88b4"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "const": "tensorrt"
              }
            },
            "required": [
              "backend"
            ]
          },
          "then": {
            "properties": {
              "tensorrt_version": {
                "pattern": "^11\\.3(\\.[0-9]+){0,2}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "const": "ort-tensorrt"
              }
            },
            "required": [
              "backend"
            ]
          },
          "then": {
            "properties": {
              "tensorrt_version": {
                "pattern": "^10\\.14(\\.[0-9]+){0,2}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "enum": [
                  "tensorrt",
                  "ort-tensorrt",
                  "tensorrt-rtx"
                ]
              },
              "status": {
                "enum": [
                  "pass",
                  "rejected",
                  "build-failed"
                ]
              }
            },
            "required": [
              "backend",
              "status"
            ]
          },
          "then": {
            "properties": {
              "tensorrt_version": {
                "not": {
                  "const": null
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "backend": {
                "enum": [
                  "pytorch",
                  "ort-cpu",
                  "ort-cuda"
                ]
              }
            },
            "required": [
              "backend"
            ]
          },
          "then": {
            "properties": {
              "tensorrt_version": {
                "const": null
              }
            }
          }
        }
      ]
    }
  }
}

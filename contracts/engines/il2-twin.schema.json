{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/engines/il2-twin.schema.json",
  "title": "Engine il2-twin: input and output messages",
  "description": "Input and output messages of the browser engine `il2-twin` (cases A3): the IL-2 excavator dig twin hosted from spec 014 (DC-018-02, spec 018-web-cases).",
  "oneOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/output"
    }
  ],
  "$defs": {
    "input": {
      "type": "object",
      "description": "Request to the engine `il2-twin`: envelope, function and its arguments in SI units.",
      "required": [
        "kind",
        "engine",
        "engine_version",
        "function",
        "args"
      ],
      "properties": {
        "kind": {
          "const": "input",
          "description": "Message kind: input for a request, output for a result (the discriminator of the root oneOf)."
        },
        "engine": {
          "const": "il2-twin",
          "description": "Engine id of spec 018 section 7.1."
        },
        "engine_version": {
          "$ref": "#/$defs/semver",
          "description": "Engine version; the host rejects any version other than the loaded one."
        },
        "function": {
          "enum": [
            "rollout"
          ],
          "description": "Function of the engine to evaluate."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "function": {
                "const": "rollout"
              }
            },
            "required": [
              "function"
            ]
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "#/$defs/rollout_args"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "output": {
      "type": "object",
      "description": "Result of the engine `il2-twin`: envelope, function and its outputs in SI units.",
      "required": [
        "kind",
        "engine",
        "engine_version",
        "function",
        "result"
      ],
      "properties": {
        "kind": {
          "const": "output",
          "description": "Message kind: input for a request, output for a result (the discriminator of the root oneOf)."
        },
        "engine": {
          "const": "il2-twin",
          "description": "Engine id of spec 018 section 7.1."
        },
        "engine_version": {
          "$ref": "#/$defs/semver",
          "description": "Engine version; the host rejects any version other than the loaded one."
        },
        "function": {
          "enum": [
            "rollout"
          ],
          "description": "Function that produced the result."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "function": {
                "const": "rollout"
              }
            },
            "required": [
              "function"
            ]
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/rollout_result"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "rollout_args": {
      "type": "object",
      "additionalProperties": false,
      "description": "Planar excavator dig twin of spec 014 driven by the IL-2 policy.",
      "required": [
        "bundle",
        "policy",
        "cohesion_pa",
        "friction_angle_rad",
        "steps",
        "seed"
      ],
      "properties": {
        "bundle": {
          "type": "object",
          "additionalProperties": false,
          "description": "Web twin bundle valid against il-twin.schema.json (DC-014-05).",
          "required": [
            "artefact",
            "sha256",
            "bytes"
          ],
          "properties": {
            "artefact": {
              "$ref": "#/$defs/artefact_id",
              "description": "Web-manifest artefact id (never a path); the loader resolves it (FR-018-43)."
            },
            "sha256": {
              "$ref": "#/$defs/sha256",
              "description": "SHA-256 of the artefact bytes, as in its manifest entry."
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 25000000,
              "description": "Size of the artefact in bytes; the engine's size cap."
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "description": "ONNX policy smaller than 1 MB (NFR-014-03).",
          "required": [
            "artefact",
            "sha256",
            "bytes"
          ],
          "properties": {
            "artefact": {
              "$ref": "#/$defs/artefact_id",
              "description": "Web-manifest artefact id (never a path); the loader resolves it (FR-018-43)."
            },
            "sha256": {
              "$ref": "#/$defs/sha256",
              "description": "SHA-256 of the artefact bytes, as in its manifest entry."
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999999,
              "description": "Size of the artefact in bytes; the engine's size cap."
            }
          }
        },
        "cohesion_pa": {
          "type": "number",
          "minimum": 0,
          "maximum": 20000,
          "description": "Soil cohesion c, 0 to 20 kPa (FR-014-19, FR-014-44)."
        },
        "friction_angle_rad": {
          "type": "number",
          "minimum": 0.4363323129985824,
          "maximum": 0.6981317007977318,
          "description": "Soil friction angle, 25 to 40 degrees (FR-014-19)."
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000,
          "description": "Policy steps to roll out (at most 2,000, spec 018 section 7.1)."
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Seed of the twin's noise terms."
        }
      }
    },
    "rollout_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "termination",
        "states",
        "actions",
        "metrics"
      ],
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000,
          "description": "Steps executed."
        },
        "termination": {
          "enum": [
            "dig-complete",
            "time-limit",
            "stall",
            "invalid_value",
            "step-limit"
          ],
          "description": "Why the rollout ended."
        },
        "states": {
          "type": "object",
          "additionalProperties": false,
          "description": "Twin state per step, initial state first.",
          "required": [
            "dtype",
            "shape",
            "byte_length"
          ],
          "properties": {
            "dtype": {
              "const": "float64",
              "description": "Element type of the buffer."
            },
            "shape": {
              "type": "object",
              "additionalProperties": false,
              "description": "Dimensions, outermost first.",
              "required": [
                "steps",
                "variables"
              ],
              "properties": {
                "steps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2001
                },
                "variables": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32
                }
              }
            },
            "byte_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512256,
              "description": "Bytes of the buffer; equals the product of the dimensions times the element size."
            }
          }
        },
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "description": "Policy action per step.",
          "required": [
            "dtype",
            "shape",
            "byte_length"
          ],
          "properties": {
            "dtype": {
              "const": "float32",
              "description": "Element type of the buffer."
            },
            "shape": {
              "type": "object",
              "additionalProperties": false,
              "description": "Dimensions, outermost first.",
              "required": [
                "steps",
                "components"
              ],
              "properties": {
                "steps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2000
                },
                "components": {
                  "const": 4
                }
              }
            },
            "byte_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32000,
              "description": "Bytes of the buffer; equals the product of the dimensions times the element size."
            }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "description": "Dig metrics of FR-014-35.",
          "required": [
            "fill_factor",
            "cycle_time_s",
            "productivity_per_s",
            "stall",
            "lift_off"
          ],
          "properties": {
            "fill_factor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1.15,
              "description": "k_f = V_fill / V_h, capped at 1.15 (FR-014-18)."
            },
            "cycle_time_s": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 30,
              "description": "Dig cycle time t_c (30 s when the dig does not complete, FR-014-35)."
            },
            "productivity_per_s": {
              "type": "number",
              "minimum": 0,
              "description": "P = k_f / t_c (FR-014-35)."
            },
            "stall": {
              "type": "boolean"
            },
            "lift_off": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "artefact_id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "semver": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

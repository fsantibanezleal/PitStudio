{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/fetch-record.schema.json",
  "title": "Fetch record",
  "description": "One record per registry file written by s00_download (DC-008-02, spec 008-data-pipeline).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "name",
    "url",
    "final_url",
    "stored_as",
    "bytes",
    "expected_bytes",
    "sha256",
    "expected_sha256",
    "publisher_checksum",
    "publisher_checksum_status",
    "spdx",
    "licence_class",
    "redistribution",
    "retrieved",
    "status",
    "fallback_sources",
    "attempts"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 200
    },
    "schema_version": {
      "$ref": "#/$defs/schema_version"
    },
    "source": {
      "$ref": "#/$defs/slug"
    },
    "name": {
      "$ref": "#/$defs/relpath",
      "description": "Local file name."
    },
    "url": {
      "$ref": "#/$defs/https_url"
    },
    "final_url": {
      "anyOf": [
        {
          "$ref": "#/$defs/https_url"
        },
        {
          "type": "null"
        }
      ]
    },
    "stored_as": {
      "anyOf": [
        {
          "$ref": "#/$defs/relpath"
        },
        {
          "type": "null"
        }
      ],
      "description": "Path relative to the data root."
    },
    "bytes": {
      "anyOf": [
        {
          "$ref": "#/$defs/file_bytes"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_bytes": {
      "anyOf": [
        {
          "$ref": "#/$defs/file_bytes"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "publisher_checksum": {
      "anyOf": [
        {
          "$ref": "sources.schema.json#/$defs/file/properties/publisher_checksum"
        },
        {
          "type": "null"
        }
      ]
    },
    "publisher_checksum_status": {
      "enum": [
        "match",
        "mismatch",
        "not-declared",
        "not-checked"
      ]
    },
    "spdx": {
      "$ref": "#/$defs/spdx_id"
    },
    "licence_class": {
      "$ref": "#/$defs/licence_class"
    },
    "redistribution": {
      "$ref": "sources.schema.json#/$defs/entry/properties/redistribution"
    },
    "retrieved": {
      "anyOf": [
        {
          "$ref": "#/$defs/utc_timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "verified",
        "fallback-used",
        "unavailable",
        "skipped-no-account",
        "pin-proposed"
      ]
    },
    "fallback_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      },
      "maxItems": 8,
      "uniqueItems": true
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "final_url": {
            "$ref": "#/$defs/https_url"
          },
          "stored_as": {
            "$ref": "#/$defs/relpath"
          },
          "bytes": {
            "$ref": "#/$defs/file_bytes"
          },
          "expected_bytes": {
            "$ref": "#/$defs/file_bytes"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "expected_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "retrieved": {
            "$ref": "#/$defs/utc_timestamp"
          },
          "publisher_checksum_status": {
            "enum": [
              "match",
              "not-declared"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "pin-proposed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "bytes": {
            "$ref": "#/$defs/file_bytes"
          },
          "expected_sha256": {
            "const": null
          },
          "publisher_checksum_status": {
            "enum": [
              "match",
              "not-declared"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "fallback-used"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "fallback_sources": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "https_url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~%!$&'()*+,;=:@/-]*)?(\\?[A-Za-z0-9._~%!$&'()*+,;=:@/?-]*)?$"
    },
    "relpath": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?(/[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?){0,15}$"
    },
    "utc_timestamp": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"
    },
    "spdx_id": {
      "enum": [
        "LicenseRef-USGov-PD",
        "CC0-1.0",
        "DL-DE-ZERO-2.0",
        "CC-BY-4.0",
        "LicenseRef-Copernicus-CLMS",
        "CC-BY-SA-3.0",
        "CC-BY-SA-4.0",
        "Apache-2.0",
        "MIT",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "MPL-2.0",
        "LGPL-2.1-or-later",
        "LicenseRef-TOST-1.0",
        "LicenseRef-NVIDIA-Open-Model",
        "LicenseRef-NVIDIA-SLA",
        "LicenseRef-NvidiaProprietary",
        "LicenseRef-NVIDIA-Omniverse",
        "LicenseRef-TensorRT-SLA",
        "LicenseRef-TensorRT-RTX-SLA"
      ]
    },
    "licence_class": {
      "enum": [
        "public-domain",
        "open-no-attribution",
        "own",
        "attribution",
        "share-alike",
        "display-only",
        "reference-only"
      ]
    },
    "schema_version": {
      "type": "string",
      "maxLength": 8,
      "pattern": "^1\\.[0-9]{1,4}$"
    },
    "file_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 68719476736
    }
  }
}

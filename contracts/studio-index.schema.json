{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/studio-index.schema.json",
  "title": "Studio index",
  "description": "Studio index web/public/studio/index.json generated by build-studio-index.mjs (DC-019-03, spec 019-web-studio).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "git_sha",
    "tools",
    "edges",
    "honesty"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 0,
      "maxLength": 200
    },
    "schema_version": {
      "type": "string",
      "maxLength": 8,
      "pattern": "^1\\.[0-9]+$"
    },
    "git_sha": {
      "$ref": "#/$defs/git_sha"
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      },
      "minItems": 0,
      "maxItems": 128
    },
    "honesty": {
      "$ref": "#/$defs/honesty"
    }
  },
  "$defs": {
    "artefact_id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "artefact_kind": {
      "enum": [
        "video",
        "image",
        "figure",
        "point-cloud",
        "mesh",
        "tiles",
        "splat",
        "onnx",
        "table",
        "trace",
        "shard",
        "field",
        "text",
        "model-card",
        "telemetry",
        "usd"
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "violations"
      ],
      "properties": {
        "id": {
          "enum": [
            "done-needs-artefact",
            "not-yet-run-has-artefact",
            "outputs-only",
            "our-scenes",
            "local-only-scrub",
            "file-guards"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "violations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/violation"
          },
          "minItems": 0,
          "maxItems": 500
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "pass"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "violations": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "fail"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "violations": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "date": {
      "type": "string",
      "maxLength": 10,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "driver": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]+(\\.[0-9]+)+$"
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "kind",
        "state"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/tool_id"
        },
        "to": {
          "$ref": "#/$defs/tool_id"
        },
        "kind": {
          "$ref": "#/$defs/artefact_kind"
        },
        "state": {
          "enum": [
            "observed",
            "planned"
          ]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "from_artefact",
            "to_artefact"
          ],
          "properties": {
            "run_id": {
              "$ref": "#/$defs/run_id"
            },
            "from_artefact": {
              "$ref": "#/$defs/artefact_id"
            },
            "to_artefact": {
              "$ref": "#/$defs/artefact_id"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "observed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "evidence"
            ]
          },
          "else": {
            "not": {
              "required": [
                "evidence"
              ]
            }
          }
        }
      ]
    },
    "git_sha": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "honesty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks",
        "definition_of_done"
      ],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          },
          "minItems": 6,
          "maxItems": 6,
          "allOf": [
            {
              "contains": {
                "properties": {
                  "id": {
                    "const": "done-needs-artefact"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "id": {
                    "const": "not-yet-run-has-artefact"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "id": {
                    "const": "outputs-only"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "id": {
                    "const": "our-scenes"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "id": {
                    "const": "local-only-scrub"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "properties": {
                  "id": {
                    "const": "file-guards"
                  }
                },
                "required": [
                  "id"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "definition_of_done": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "studio_tools",
            "satisfied",
            "missing",
            "met"
          ],
          "properties": {
            "studio_tools": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "satisfied": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            },
            "missing": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/tool_id"
              },
              "minItems": 0,
              "maxItems": 64,
              "uniqueItems": true
            },
            "met": {
              "type": "boolean"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "met": {
                    "const": true
                  }
                },
                "required": [
                  "met"
                ]
              },
              "then": {
                "properties": {
                  "missing": {
                    "maxItems": 0
                  }
                }
              },
              "else": {
                "properties": {
                  "missing": {
                    "minItems": 1
                  }
                }
              }
            }
          ],
          "description": "SC-019-01: each studio tool has a published artefact or an evaluated-not-adopted page."
        }
      }
    },
    "json_pointer": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(/([A-Za-z0-9_.$-]|~[01]){1,64}){1,32}$"
    },
    "local_only": {
      "const": "measured locally, not published (licence)"
    },
    "metrics": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": [
          "number",
          "string"
        ],
        "maxLength": 200
      },
      "maxProperties": 64
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "band",
        "order",
        "group",
        "x_px",
        "y_px"
      ],
      "properties": {
        "band": {
          "$ref": "toolmap.schema.json#/$defs/band_id"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "group": {
          "enum": [
            "map",
            "not-adopted"
          ]
        },
        "x_px": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        },
        "y_px": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        }
      },
      "description": "Build-time layout: integer pixel coordinates so that identical inputs give identical bytes."
    },
    "probe": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "probe_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "skip",
            "not-probed"
          ]
        },
        "name": {
          "$ref": "#/$defs/probe"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "gpu": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "driver": {
          "$ref": "#/$defs/driver"
        },
        "metrics": {
          "oneOf": [
            {
              "$ref": "#/$defs/metrics"
            },
            {
              "$ref": "#/$defs/local_only"
            }
          ]
        },
        "error": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "skip"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "name",
              "date",
              "gpu",
              "driver"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not-probed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "name"
                  ]
                },
                {
                  "required": [
                    "date"
                  ]
                },
                {
                  "required": [
                    "gpu"
                  ]
                },
                {
                  "required": [
                    "driver"
                  ]
                },
                {
                  "required": [
                    "metrics"
                  ]
                },
                {
                  "required": [
                    "error"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "fail"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "error"
            ]
          },
          "else": {
            "not": {
              "required": [
                "error"
              ]
            }
          }
        }
      ],
      "description": "Capability-probe status from studio/capabilities.json; never 'pass' without a passing probe."
    },
    "relpath": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?(/[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?){0,15}$"
    },
    "run_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]{0,47}$"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "position",
        "version",
        "probe",
        "artefacts"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/tool_id"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "version": {
          "$ref": "#/$defs/version_ref"
        },
        "probe": {
          "$ref": "#/$defs/probe_status"
        },
        "artefacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artefact_id"
          },
          "minItems": 0,
          "maxItems": 2000,
          "uniqueItems": true
        }
      }
    },
    "tool_id": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9-]{1,47}$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$"
    },
    "version_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "release_date",
        "from"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/version"
        },
        "release_date": {
          "oneOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "const": null
            }
          ]
        },
        "from": {
          "enum": [
            "lock",
            "binary",
            "git-tag",
            "own"
          ]
        },
        "lock": {
          "enum": [
            "uv.lock",
            "studio/uv.lock",
            "studio/isaac/uv.lock",
            "studio/rtx/uv.lock",
            "studio/isaaclab/uv.lock",
            "pipeline/uv.lock",
            "pipeline/accel/uv.lock",
            "web/pnpm-lock.yaml"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "from": {
                "const": "lock"
              }
            },
            "required": [
              "from"
            ]
          },
          "then": {
            "required": [
              "lock"
            ]
          },
          "else": {
            "not": {
              "required": [
                "lock"
              ]
            }
          }
        }
      ],
      "description": "Version resolved from the lock, the pinned binary record, the git tag or VERSION; release_date null when the source records none."
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "tool": {
          "$ref": "#/$defs/tool_id"
        },
        "artefact": {
          "$ref": "#/$defs/artefact_id"
        },
        "file": {
          "$ref": "#/$defs/relpath"
        },
        "field": {
          "$ref": "#/$defs/json_pointer"
        }
      },
      "anyOf": [
        {
          "required": [
            "tool"
          ]
        },
        {
          "required": [
            "artefact"
          ]
        },
        {
          "required": [
            "file"
          ]
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/knowledge-bundle.schema.json",
  "title": "Knowledge bundle",
  "description": "Knowledge bundle web/public/knowledge/bundle.json generated by build_knowledge.py from the pinned minephys export (DC-020-03, spec 020-web-knowledge).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "parameters",
    "equations",
    "glossary",
    "datasets",
    "frameworks",
    "bibliography"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 0,
      "maxLength": 200
    },
    "schema_version": {
      "type": "string",
      "maxLength": 8,
      "pattern": "^1\\.[0-9]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minephys_version",
        "minephys_commit",
        "inputs"
      ],
      "properties": {
        "minephys_version": {
          "$ref": "#/$defs/version"
        },
        "minephys_commit": {
          "$ref": "#/$defs/git_sha"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/relpath"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "minItems": 0,
          "maxItems": 8
        }
      },
      "description": "The pinned minephys knowledge export and the PitStudio files the bundle was built from."
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "equations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/equation"
      },
      "minItems": 0,
      "maxItems": 2000
    },
    "glossary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/term"
      },
      "minItems": 0,
      "maxItems": 5000
    },
    "datasets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataset"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "frameworks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/framework"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "bibliography": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bib_entry"
      },
      "minItems": 0,
      "maxItems": 5000
    }
  },
  "$defs": {
    "bib_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "entry_type",
        "authors",
        "title",
        "year",
        "access",
        "cited_by"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/bib_key"
        },
        "entry_type": {
          "enum": [
            "article",
            "book",
            "inbook",
            "inproceedings",
            "techreport",
            "manual",
            "misc"
          ]
        },
        "authors": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "year": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2100
        },
        "doi": {
          "type": "string",
          "maxLength": 220,
          "pattern": "^10\\.[0-9]{4,9}/[!-~]{1,200}$"
        },
        "url": {
          "$ref": "#/$defs/https_url"
        },
        "access": {
          "enum": [
            "open",
            "paywalled",
            "regulation",
            "bibliographic-only"
          ]
        },
        "cited_by": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parameters",
            "equations"
          ],
          "properties": {
            "parameters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/knowledge_row_id"
              },
              "minItems": 0,
              "maxItems": 10000,
              "uniqueItems": true
            },
            "equations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/knowledge_row_id"
              },
              "minItems": 0,
              "maxItems": 2000,
              "uniqueItems": true
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "doi"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ]
    },
    "bib_key": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_:-]{0,63}$"
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind",
        "spdx",
        "redistribution",
        "landing_url",
        "card"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "kind": {
          "enum": [
            "real",
            "synthetic"
          ]
        },
        "spdx": {
          "$ref": "#/$defs/spdx_id"
        },
        "redistribution": {
          "enum": [
            "redistributable",
            "derived-only",
            "no-redistribution"
          ]
        },
        "landing_url": {
          "$ref": "#/$defs/https_url"
        },
        "card": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^data/cards/[a-z0-9-]{1,64}\\.md$"
        }
      }
    },
    "date": {
      "type": "string",
      "maxLength": 10,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "equation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "module",
        "latex",
        "symbols",
        "function",
        "citation",
        "page",
        "verification"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/knowledge_row_id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "module": {
          "$ref": "#/$defs/module"
        },
        "latex": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol",
              "meaning",
              "units"
            ],
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "meaning": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "units": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          },
          "minItems": 1,
          "maxItems": 64
        },
        "function": {
          "$ref": "#/$defs/minephys_symbol"
        },
        "citation": {
          "$ref": "#/$defs/bib_key"
        },
        "page": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "verified_on": {
          "$ref": "#/$defs/date"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledge_row_id"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "theory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "topic",
            "anchor"
          ],
          "properties": {
            "topic": {
              "$ref": "figures.schema.json#/$defs/topic"
            },
            "anchor": {
              "type": "string",
              "maxLength": 67,
              "pattern": "^eq-[a-z0-9-]{1,64}$"
            }
          }
        },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "spec"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 32,
              "pattern": "^[a-z][a-z0-9-]{1,31}$"
            },
            "spec": {
              "enum": [
                "007-haulage-dispatch",
                "013-sensors",
                "014-robot-learning",
                "018-web-cases"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification": {
                "const": "verified"
              }
            },
            "required": [
              "verification"
            ]
          },
          "then": {
            "required": [
              "verified_on"
            ]
          },
          "else": {
            "not": {
              "required": [
                "verified_on"
              ]
            }
          }
        }
      ]
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "status",
        "licence_class"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/tool_id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "category": {
          "enum": [
            "studio-tool",
            "component"
          ]
        },
        "status": {
          "enum": [
            "not-yet-run",
            "done",
            "evaluated-not-adopted"
          ]
        },
        "licence_class": {
          "$ref": "#/$defs/licence_class"
        }
      }
    },
    "git_sha": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "https_url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~%!$&'()*+,;=:@/-]*)?(\\?[A-Za-z0-9._~%!$&'()*+,;=:@/?-]*)?$"
    },
    "knowledge_row_id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z][a-z0-9_]{0,95}$"
    },
    "licence_class": {
      "enum": [
        "public-domain",
        "open-no-attribution",
        "own",
        "attribution",
        "share-alike",
        "display-only",
        "reference-only"
      ]
    },
    "minephys_symbol": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^minephys(\\.[a-z_][a-z0-9_]{0,63}){1,4}$"
    },
    "module": {
      "enum": [
        "haulage",
        "blasting",
        "geotech",
        "bulk",
        "comminution",
        "environment",
        "planning"
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "module",
        "units",
        "si",
        "citation",
        "page",
        "verification",
        "symbols",
        "licence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/knowledge_row_id"
        },
        "module": {
          "$ref": "#/$defs/module"
        },
        "quantity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "value": {
          "type": [
            "number",
            "string"
          ],
          "maxLength": 41,
          "pattern": "^-?[0-9]{1,20}/[0-9]{1,20}$"
        },
        "range": {
          "$ref": "#/$defs/range"
        },
        "units": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "si": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "range": {
              "$ref": "#/$defs/range"
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          },
          "oneOf": [
            {
              "required": [
                "value"
              ]
            },
            {
              "required": [
                "range"
              ]
            }
          ]
        },
        "citation": {
          "$ref": "#/$defs/bib_key"
        },
        "page": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "verified_on": {
          "$ref": "#/$defs/date"
        },
        "symbols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/minephys_symbol"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "role": {
          "enum": [
            "model_constant",
            "parameter",
            "limit",
            "conversion"
          ]
        },
        "licence": {
          "$ref": "#/$defs/spdx_id"
        }
      },
      "oneOf": [
        {
          "required": [
            "value"
          ]
        },
        {
          "required": [
            "range"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "verification": {
                "const": "verified"
              }
            },
            "required": [
              "verification"
            ]
          },
          "then": {
            "required": [
              "verified_on"
            ]
          },
          "else": {
            "not": {
              "required": [
                "verified_on"
              ]
            }
          }
        }
      ],
      "description": "One knowledge-table row as published, with its SI conversion."
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "relpath": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?(/[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?){0,15}$"
    },
    "sha256": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "spdx_id": {
      "enum": [
        "LicenseRef-USGov-PD",
        "CC0-1.0",
        "DL-DE-ZERO-2.0",
        "CC-BY-4.0",
        "LicenseRef-Copernicus-CLMS",
        "CC-BY-SA-3.0",
        "CC-BY-SA-4.0",
        "Apache-2.0",
        "MIT",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "MPL-2.0",
        "LGPL-2.1-or-later",
        "LicenseRef-TOST-1.0",
        "LicenseRef-NVIDIA-Open-Model",
        "LicenseRef-NVIDIA-SLA",
        "LicenseRef-NvidiaProprietary",
        "LicenseRef-NVIDIA-Omniverse",
        "LicenseRef-TensorRT-SLA",
        "LicenseRef-TensorRT-RTX-SLA"
      ]
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origin",
        "term_en",
        "term_es",
        "definition_en",
        "definition_es"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "origin": {
          "enum": [
            "minephys",
            "docs"
          ]
        },
        "term_en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "term_es": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "definition_en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "definition_es": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "citation": {
          "$ref": "#/$defs/bib_key"
        },
        "see_also": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 96,
            "pattern": "^[a-z][a-z0-9_-]{0,95}$"
          },
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true
        }
      }
    },
    "tool_id": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9-]{1,47}$"
    },
    "verification": {
      "enum": [
        "verified",
        "UNVERIFIED"
      ]
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$"
    }
  }
}

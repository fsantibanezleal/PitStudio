{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/web-cloud-shard.schema.json",
  "title": "PitStudio web point-cloud shard header",
  "description": "Header of a quantised web point-cloud shard written by s60_export for the replay viewer (DC-013-04, spec 013-sensors).",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "points",
    "quantisation",
    "encoding",
    "intensity_map",
    "classes",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 200
    },
    "schema_version": {
      "$ref": "#/$defs/schema_version"
    },
    "source": {
      "description": "Sensor frame the shard was converted from.",
      "type": "object",
      "required": [
        "run_id",
        "scenario",
        "sensor",
        "frame"
      ],
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "$ref": "#/$defs/run_id"
        },
        "scenario": {
          "enum": [
            "S1",
            "S4a",
            "rain"
          ]
        },
        "sensor": {
          "$ref": "sensor-recipe.schema.json#/$defs/sensor_id"
        },
        "frame": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "points": {
      "description": "Points in the payload (8 bytes each).",
      "type": "integer",
      "minimum": 0,
      "maximum": 1250000
    },
    "quantisation": {
      "$ref": "#/$defs/quantisation"
    },
    "encoding": {
      "description": "Fixed payload layout.",
      "type": "object",
      "required": [
        "position",
        "intensity",
        "class",
        "byte_order",
        "layout"
      ],
      "additionalProperties": false,
      "properties": {
        "position": {
          "const": "uint16"
        },
        "intensity": {
          "const": "uint8"
        },
        "class": {
          "const": "uint8"
        },
        "byte_order": {
          "const": "little"
        },
        "layout": {
          "description": "x[], y[], z[], intensity[], class[] in this order.",
          "const": "planar"
        }
      }
    },
    "intensity_map": {
      "description": "Linear map of the uint8 intensity channel to its quantity.",
      "type": "object",
      "required": [
        "quantity",
        "low",
        "high"
      ],
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "enum": [
            "lidar-intensity",
            "radar-rcs-dbsm",
            "radar-radial-velocity-m-per-s"
          ]
        },
        "low": {
          "description": "Value of uint8 code 0.",
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        },
        "high": {
          "description": "Value of uint8 code 255.",
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        }
      }
    },
    "classes": {
      "$ref": "#/$defs/classes"
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "run_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]{0,47}$"
    },
    "sha256": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "relpath": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?(/[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?){0,15}$"
    },
    "schema_version": {
      "description": "Contract version (major 1).",
      "type": "string",
      "maxLength": 8,
      "pattern": "^1\\.[0-9]+$"
    },
    "quantisation": {
      "description": "Dequantised coordinate = offset_m + scale_m * q, q the uint16 value.",
      "type": "object",
      "required": [
        "offset_m",
        "scale_m"
      ],
      "additionalProperties": false,
      "properties": {
        "offset_m": {
          "description": "Per-axis offset (m): the minimum of the shard's bounding box.",
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -100000000,
            "maximum": 100000000
          },
          "minItems": 3,
          "maxItems": 3
        },
        "scale_m": {
          "description": "Per-axis scale (m per uint16 step) = extent / 65535; 1 for an axis of zero extent.",
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "payload": {
      "description": "Binary payload of a web shard.",
      "type": "object",
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "Binary payload next to the header.",
          "$ref": "#/$defs/relpath"
        },
        "bytes": {
          "description": "Payload size (bytes), at most 10 MB.",
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "classes": {
      "description": "Class code (uint8, decimal string) to label.",
      "type": "object",
      "propertyNames": {
        "maxLength": 3,
        "pattern": "^([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/slug"
      },
      "maxProperties": 256,
      "minProperties": 1
    }
  }
}

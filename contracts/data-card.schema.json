{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/data-card.schema.json",
  "title": "Data-card front matter",
  "description": "Front matter of data/cards/<id>.md for real and synthetic sets (DC-008-05, spec 008-data-pipeline).",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/real_card"
    },
    {
      "$ref": "#/$defs/synthetic_card"
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "https_url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~%!$&'()*+,;=:@/-]*)?(\\?[A-Za-z0-9._~%!$&'()*+,;=:@/?-]*)?$"
    },
    "spdx_id": {
      "enum": [
        "LicenseRef-USGov-PD",
        "CC0-1.0",
        "DL-DE-ZERO-2.0",
        "CC-BY-4.0",
        "LicenseRef-Copernicus-CLMS",
        "CC-BY-SA-3.0",
        "CC-BY-SA-4.0",
        "Apache-2.0",
        "MIT",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "MPL-2.0",
        "LGPL-2.1-or-later",
        "LicenseRef-TOST-1.0",
        "LicenseRef-NVIDIA-Open-Model",
        "LicenseRef-NVIDIA-SLA",
        "LicenseRef-NvidiaProprietary",
        "LicenseRef-NVIDIA-Omniverse",
        "LicenseRef-TensorRT-SLA",
        "LicenseRef-TensorRT-RTX-SLA"
      ]
    },
    "licence_class": {
      "enum": [
        "public-domain",
        "open-no-attribution",
        "own",
        "attribution",
        "share-alike",
        "display-only",
        "reference-only"
      ]
    },
    "module_path": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[a-z_][a-z0-9_]{0,63}(\\.[a-z_][a-z0-9_]{0,63}){0,7}$"
    },
    "stage_id": {
      "enum": [
        "s00_download",
        "s05_synthesize",
        "s10_preprocess",
        "s20_feature_extraction",
        "s30_train",
        "s40_infer",
        "s50_evaluate",
        "s60_export",
        "s62_accel",
        "s64_bench",
        "st10_terrain",
        "st20_pit_design",
        "st30_assets",
        "st40_compose",
        "st45_validate",
        "st45b_kit_validate",
        "st50_physics",
        "st52_rtx_render",
        "st53_sensors",
        "st54_vehicles",
        "st55_sdg",
        "st56_encode",
        "st57_rain_lidar",
        "st58_kit_capture",
        "st58b_capture_splat",
        "st59_reason_bench",
        "st59a_vqa",
        "st59b_plausibility",
        "st59c_captions",
        "st60_il_train",
        "st61_il_mpm_eval"
      ]
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$"
    },
    "git_sha": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "real_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "spdx",
        "licence_class",
        "redistribution",
        "files_sha256",
        "kind",
        "landing_url",
        "citation"
      ],
      "properties": {
        "$schema": {
          "type": "string",
          "maxLength": 200
        },
        "id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "spdx": {
          "$ref": "#/$defs/spdx_id"
        },
        "licence_class": {
          "$ref": "#/$defs/licence_class"
        },
        "redistribution": {
          "$ref": "sources.schema.json#/$defs/entry/properties/redistribution"
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "files_sha256": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxItems": 512
        },
        "kind": {
          "const": "real"
        },
        "landing_url": {
          "$ref": "#/$defs/https_url"
        },
        "citation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "licence_class": {
                "enum": [
                  "attribution",
                  "share-alike"
                ]
              }
            },
            "required": [
              "licence_class"
            ]
          },
          "then": {
            "required": [
              "attribution"
            ]
          }
        }
      ]
    },
    "synthetic_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "spdx",
        "licence_class",
        "redistribution",
        "files_sha256",
        "kind",
        "synthetic",
        "generator",
        "config_sha256",
        "seeds",
        "priors",
        "assets",
        "validation"
      ],
      "properties": {
        "$schema": {
          "type": "string",
          "maxLength": 200
        },
        "id": {
          "$ref": "#/$defs/slug"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "spdx": {
          "$ref": "#/$defs/spdx_id"
        },
        "licence_class": {
          "$ref": "#/$defs/licence_class"
        },
        "redistribution": {
          "$ref": "sources.schema.json#/$defs/entry/properties/redistribution"
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "files_sha256": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxItems": 512
        },
        "kind": {
          "const": "synthetic"
        },
        "synthetic": {
          "const": true
        },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "module",
            "stage",
            "version",
            "git_sha"
          ],
          "properties": {
            "module": {
              "$ref": "#/$defs/module_path"
            },
            "stage": {
              "$ref": "#/$defs/stage_id"
            },
            "version": {
              "$ref": "#/$defs/version"
            },
            "git_sha": {
              "$ref": "#/$defs/git_sha"
            }
          }
        },
        "config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true
        },
        "priors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "citation",
              "page"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "citation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "page": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              }
            }
          },
          "maxItems": 256
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "spdx",
              "licence_class",
              "sha256"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "spdx": {
                "$ref": "#/$defs/spdx_id"
              },
              "licence_class": {
                "$ref": "#/$defs/licence_class"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "maxItems": 1024
        },
        "validation": {
          "$ref": "#/$defs/validation"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "licence_class": {
                "enum": [
                  "attribution",
                  "share-alike"
                ]
              }
            },
            "required": [
              "licence_class"
            ]
          },
          "then": {
            "required": [
              "attribution"
            ]
          }
        }
      ]
    },
    "validation_test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test",
        "verdict",
        "metric"
      ],
      "properties": {
        "test": {
          "enum": [
            "c2st",
            "tstr"
          ]
        },
        "verdict": {
          "enum": [
            "pending",
            "pass",
            "warn",
            "fail"
          ]
        },
        "metric": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "value",
                "ci95_low",
                "ci95_high"
              ],
              "properties": {
                "name": {
                  "enum": [
                    "auc",
                    "auc-minus-real-baseline",
                    "tstr-trtr-ratio"
                  ]
                },
                "value": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "ci95_low": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                "ci95_high": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "enum": [
            "validated-against-real",
            "descriptive-only",
            "unvalidated"
          ]
        },
        "real_reference": {
          "$ref": "#/$defs/slug"
        },
        "tests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/validation_test"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "label": {
          "const": "calibrated synthetic — not validated against real data"
        },
        "c2st_tstr": {
          "const": "not-applicable"
        },
        "basis": {
          "const": "single real event"
        },
        "physics_benchmarks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "benchmark",
              "verdict"
            ],
            "properties": {
              "benchmark": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "verdict": {
                "enum": [
                  "pending",
                  "pass",
                  "fail"
                ]
              }
            }
          },
          "maxItems": 32
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "class": {
                "const": "validated-against-real"
              }
            },
            "required": [
              "class"
            ]
          },
          "then": {
            "required": [
              "real_reference",
              "tests"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "label"
                  ]
                },
                {
                  "required": [
                    "c2st_tstr"
                  ]
                },
                {
                  "required": [
                    "basis"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "class": {
                "const": "descriptive-only"
              }
            },
            "required": [
              "class"
            ]
          },
          "then": {
            "required": [
              "basis"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "tests"
                  ]
                },
                {
                  "required": [
                    "label"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "class": {
                "const": "unvalidated"
              }
            },
            "required": [
              "class"
            ]
          },
          "then": {
            "required": [
              "label",
              "c2st_tstr"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "tests"
                  ]
                },
                {
                  "required": [
                    "real_reference"
                  ]
                },
                {
                  "required": [
                    "basis"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}

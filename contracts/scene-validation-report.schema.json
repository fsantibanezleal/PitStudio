{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/scene-validation-report.schema.json",
  "title": "Scene validation report",
  "description": "Validator results, scene invariants, waivers and the build-twice hashes written by st45_validate (DC-004-07, spec 004-scene-pipeline).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "case",
    "manifest_id",
    "params_sha256",
    "status",
    "passed",
    "validators",
    "selections",
    "invariants",
    "waivers",
    "determinism"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 200
    },
    "schema_version": {
      "$ref": "#/$defs/schema_version"
    },
    "kind": {
      "const": "scene-validation-report"
    },
    "case": {
      "$ref": "#/$defs/case_id"
    },
    "manifest_id": {
      "$ref": "#/$defs/slug"
    },
    "params_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "enum": [
        "complete",
        "incomplete"
      ],
      "description": "incomplete when a validator did not run"
    },
    "passed": {
      "type": "boolean"
    },
    "validators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validator_run"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "selections": {
      "type": "array",
      "description": "variant selections validated (FR-004-34)",
      "items": {
        "$ref": "#/$defs/selection"
      },
      "minItems": 1,
      "maxItems": 1024
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer_units_axis",
        "class_label_coverage",
        "time_sampled_labels",
        "articulation_roots",
        "cyclic_joint_graphs",
        "non_positive_masses",
        "bench_height_deviation",
        "face_angle_deviation",
        "ramp_grade_max",
        "windrow_margin",
        "terrain_range_excess",
        "cut_fill_identity_residual",
        "forbidden_paths",
        "layer_size_max"
      ],
      "properties": {
        "layer_units_axis": {
          "$ref": "#/$defs/inv_layer_units_axis"
        },
        "class_label_coverage": {
          "$ref": "#/$defs/inv_class_label_coverage"
        },
        "time_sampled_labels": {
          "$ref": "#/$defs/inv_time_sampled_labels"
        },
        "articulation_roots": {
          "$ref": "#/$defs/inv_articulation_roots"
        },
        "cyclic_joint_graphs": {
          "$ref": "#/$defs/inv_cyclic_joint_graphs"
        },
        "non_positive_masses": {
          "$ref": "#/$defs/inv_non_positive_masses"
        },
        "bench_height_deviation": {
          "$ref": "#/$defs/inv_bench_height_deviation"
        },
        "face_angle_deviation": {
          "$ref": "#/$defs/inv_face_angle_deviation"
        },
        "ramp_grade_max": {
          "$ref": "#/$defs/inv_ramp_grade_max"
        },
        "windrow_margin": {
          "$ref": "#/$defs/inv_windrow_margin"
        },
        "terrain_range_excess": {
          "$ref": "#/$defs/inv_terrain_range_excess"
        },
        "cut_fill_identity_residual": {
          "$ref": "#/$defs/inv_cut_fill_identity_residual"
        },
        "forbidden_paths": {
          "$ref": "#/$defs/inv_forbidden_paths"
        },
        "layer_size_max": {
          "$ref": "#/$defs/inv_layer_size_max"
        }
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "$ref": "scene-spec.schema.json#/$defs/waiver"
      },
      "maxItems": 32
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "layers",
        "identical",
        "stage_hash"
      ],
      "properties": {
        "class": {
          "const": "bitwise"
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/determinism_layer"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "identical": {
          "type": "boolean"
        },
        "stage_hash": {
          "$ref": "#/$defs/sha256",
          "description": "SHA-256 of the sorted (role, sha256) list (FR-004-36)"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "validators": {
            "contains": {
              "properties": {
                "status": {
                  "const": "not_run"
                }
              },
              "required": [
                "status"
              ]
            }
          }
        },
        "required": [
          "validators"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "incomplete"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "incomplete"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "passed": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "determinism": {
            "properties": {
              "identical": {
                "const": false
              }
            },
            "required": [
              "identical"
            ]
          }
        },
        "required": [
          "determinism"
        ]
      },
      "then": {
        "properties": {
          "passed": {
            "const": false
          }
        }
      }
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "relpath": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?(/[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?){0,15}$"
    },
    "case_id": {
      "enum": [
        "A1",
        "A2",
        "A3",
        "B1",
        "B2",
        "C1",
        "C2",
        "C3",
        "D1",
        "D2",
        "E1",
        "E2"
      ]
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$"
    },
    "schema_version": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^1\\.[0-9]+$"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "severity",
        "prim",
        "message",
        "waived"
      ],
      "properties": {
        "rule": {
          "$ref": "scene-spec.schema.json#/$defs/rule_id"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "prim": {
          "anyOf": [
            {
              "$ref": "scene-digest.schema.json#/$defs/prim_path"
            },
            {
              "const": null
            }
          ]
        },
        "message": {
          "type": "string",
          "description": "scrubbed validator message",
          "minLength": 1,
          "maxLength": 300
        },
        "waived": {
          "type": "boolean"
        }
      }
    },
    "validator_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "status",
        "results"
      ],
      "properties": {
        "id": {
          "enum": [
            "usd-validation-nvidia",
            "simready-validate"
          ]
        },
        "version": {
          "anyOf": [
            {
              "$ref": "#/$defs/version"
            },
            {
              "const": null
            }
          ],
          "description": "read from studio/uv.lock"
        },
        "status": {
          "enum": [
            "ran",
            "not_run"
          ]
        },
        "reason": {
          "type": "string",
          "description": "why the validator did not run (FR-004-38)",
          "minLength": 1,
          "maxLength": 300
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/result"
          },
          "maxItems": 5000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_run"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "results": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "reason"
              ]
            }
          }
        }
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pushback",
        "scenario",
        "time_of_day",
        "weather",
        "lod"
      ],
      "properties": {
        "pushback": {
          "$ref": "scene-spec.schema.json#/$defs/variant_name"
        },
        "scenario": {
          "$ref": "scene-spec.schema.json#/$defs/variant_name"
        },
        "time_of_day": {
          "$ref": "scene-spec.schema.json#/$defs/time_of_day"
        },
        "weather": {
          "$ref": "scene-spec.schema.json#/$defs/weather"
        },
        "lod": {
          "$ref": "scene-spec.schema.json#/$defs/lod_name"
        }
      }
    },
    "determinism_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "format",
        "method",
        "first_sha256",
        "second_sha256",
        "equal"
      ],
      "properties": {
        "role": {
          "$ref": "scene-manifest.schema.json#/$defs/layer_role"
        },
        "path": {
          "$ref": "#/$defs/relpath"
        },
        "format": {
          "enum": [
            "usda",
            "usdc"
          ]
        },
        "method": {
          "enum": [
            "bytes",
            "flattened-text"
          ]
        },
        "first_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "second_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "equal": {
          "type": "boolean"
        },
        "first_difference": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "line",
            "first",
            "second"
          ],
          "properties": {
            "line": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000000
            },
            "first": {
              "type": "string",
              "maxLength": 300
            },
            "second": {
              "type": "string",
              "maxLength": 300
            }
          },
          "description": "first differing line of the two text exports (FR-004-39)"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "usda"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "method": {
                "const": "bytes"
              }
            }
          },
          "else": {
            "properties": {
              "method": {
                "const": "flattened-text"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "equal": {
                "const": false
              }
            },
            "required": [
              "equal"
            ]
          },
          "then": {
            "required": [
              "first_difference"
            ]
          },
          "else": {
            "not": {
              "required": [
                "first_difference"
              ]
            }
          }
        }
      ]
    },
    "inv_layer_units_axis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured",
        "unit",
        "limit",
        "comparison",
        "passed"
      ],
      "properties": {
        "measured": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "const": "count"
        },
        "limit": {
          "const": 0
        },
        "comparison": {
          "const": "le"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "description": "layers whose upAxis, metersPerUnit or kilogramsPerUnit is wrong or unauthored (FR-004-35)",
      "allOf": [
        {
          "if": {
            "properties": {
              "passed": {
                "const": true
              }
            },
            "required": [
              "passed"
            ]
          },
          "then": {
            "properties": {
              "measured": {
                "maximum": 0
              }
            }
          },
          "else": {
            "properties": {
              "measured": {
                "exclusiveMinimum": 0
              }
            }
          }
        }
      ]
    },
    "inv_class_label_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured",
        "unit",
        "limit",
        "comparison",
        "passed"
      ],
      "properties": {
        "measured": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "unit": {
          "const": "fraction"
        },
        "limit": {
          "const": 1.0
        },
        "comparison": {
          "const": "ge"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "description": "share of geometry prims carrying exactly one class label (FR-004-35)",
      "allOf": [
        {
          "if": {
            "properties": {
              "passed": {
                "const": true
              }
            },
            "required": [
              "passed"
            ]
          },
          "then": {
            "properties": {
              "measured": {
                "minimum": 1.0
              }
            }
          },
          "else": {
            "properties": {
              "measured": {
                "exclusiveMaximum": 1.0
              }
            }
          }
        }
      ]
    },
    "inv_time_sampled_labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured",
        "unit",
        "limit",
        "comparison",
        "passed"
      ],
      "properties": {
        "measured": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "const": "count"
        },
        "limit": {
          "const": 0
        },
        "comparison": {
          "const": "le"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "description": "label attributes with time samples (FR-004-35)",
      "allOf": [
        {
          "if": {
            "properties": {
              "passed": {
                "const": true
              }
            },
            "required": [
              "passed"
            ]
          },
          "then": {
            "properties": {
              "measured": {
                "maximum": 0
              }
            }
          },
          "else": {
            "properties": {
              "measured": {
                "exclusiveMinimum": 0
              }
            }
          }
        }
      ]
    },
    "inv_articulation_roots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured",
        "unit",
        "limit",
        "comparison",
        "passed"
      ],
      "properties": {
        "measured": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "const": "count"
        },
        "limit": {
          "const": 0
        },
        "comparison": {
          "const": "le"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "description": "machines without exactly one articulation root (FR-004-35)",
      "allOf": [
        {
          "if": {
            "properties": {
              "passed": {
                "const": true
              }
            },
            "required": [
              "passed"
            ]
          },
          "then": {
            "properties": {
              "measured": {
                "maximum": 0
              }
            }
          },
          "else": {
            "properties": {
              "measured": {
                "exclusiveMinimum": 0
              }
            }
          }
        }
      ]
    },
    "inv_cyclic_joint_graphs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured",
        "unit",
        "limit",
        "comparison",
        "passed"
      ],
      "properties": {
        "measured": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "const": "count"
        },
        "limit": {
          "const": 0
        },
        "comparison": {
          "const": "le"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "description": "machines whose joint graph is not a tree (FR-004-35)",
      "allOf": [
        {
          "if": {
            "properties": {
              "passed": {
                "const": true
              }
            },
            "required": [
              "passed"
            ]
          },
          "then": {
            "properties": {
              "measured": {
                "maximum": 0
              }
            }
          },
          "else": {
            "properties": {
              "measured": {
                "exclusiveMinimum": 0
              }
            }
          }
        }
      ]
    },
    "inv_non_positive_masses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured",
        "unit",
        "limit",
        "comparison",
        "passed"
      ],
      "properties": {
        "measured": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "const": "count"
        },
        "limit": {
          "const": 0
        },
        "comparison": {
          "const": "le"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "description": "bodies with mass <= 0 (FR-004-35)",
      "allOf": [
        {
          "if": {
            "properties": {
              "passed": {
                "const": true
              }
            },
            "required": [
              "passed"
            ]
          },
          "then": {
            "properties": {
              "measured": {
                "maximum": 0
              }
            }
          },
          "else": {
            "properties": {
              "measured": {
                "exclusiveMinimum": 0
              }
            }
          }
        }
      ]
    },
    "inv_bench_height_deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured",
        "unit",
        "limit",
        "comparison",
        "passed"
      ],
      "properties": {
        "measured": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "unit": {
          "const": "m"
        },
        "limit": {
          "const": 0.5
        },
        "comparison": {
          "const": "le"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "description": "largest |measured bench height - H| (FR-004-35)",
      "allOf": [
        {
          "if": {
            "properties": {
              "passed": {
                "const": true
              }
            },
            "required": [
              "passed"
            ]
          },
          "then": {
            "properties": {
              "measured": {
                "maximum": 0.5
              }
            }
          },
          "else": {
            "properties": {
              "measured": {
                "exclusiveMinimum": 0.5
              }
            }
          }
        }
      ]
    },
    "inv_face_angle_deviation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured",
        "unit",
        "limit",
        "comparison",
        "passed"
      ],
      "properties": {
        "measured": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "unit": {
          "const": "deg"
        },
        "limit": {
          "const": 1.0
        },
        "comparison": {
          "const": "le"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "description": "largest |measured face angle - alpha| (FR-004-35)",
      "allOf": [
        {
          "if": {
            "properties": {
              "passed": {
                "const": true
              }
            },
            "required": [
              "passed"
            ]
          },
          "then": {
            "properties": {
              "measured": {
                "maximum": 1.0
              }
            }
          },
          "else": {
            "properties": {
              "measured": {
                "exclusiveMinimum": 1.0
              }
            }
          }
        }
      ]
    },
    "inv_ramp_grade_max": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured",
        "unit",
        "limit",
        "comparison",
        "passed"
      ],
      "properties": {
        "measured": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "unit": {
          "const": "pct"
        },
        "limit": {
          "type": "number",
          "description": "g + 0.1 %",
          "minimum": 0.1,
          "maximum": 15.1
        },
        "comparison": {
          "const": "le"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "description": "largest ramp centreline grade; limit g + 0.1 % (FR-004-35)"
    },
    "inv_windrow_margin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured",
        "unit",
        "limit",
        "comparison",
        "passed"
      ],
      "properties": {
        "measured": {
          "type": "number",
          "minimum": -5,
          "maximum": 5
        },
        "unit": {
          "const": "m"
        },
        "limit": {
          "const": 0
        },
        "comparison": {
          "const": "ge"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "description": "smallest windrow height minus the largest mid-axle height (FR-004-35)",
      "allOf": [
        {
          "if": {
            "properties": {
              "passed": {
                "const": true
              }
            },
            "required": [
              "passed"
            ]
          },
          "then": {
            "properties": {
              "measured": {
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "measured": {
                "exclusiveMaximum": 0
              }
            }
          }
        }
      ]
    },
    "inv_terrain_range_excess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured",
        "unit",
        "limit",

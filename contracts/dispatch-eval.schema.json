{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/dispatch-eval.schema.json",
  "title": "Paired dispatch evaluation table",
  "description": "Per-seed dispatcher KPIs and paired learned-versus-baseline verdicts written by s50_evaluate (DC-007-03, spec 007-haulage-dispatch).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "recipe",
    "engine",
    "mode",
    "variate_profile",
    "primary_metric",
    "ci_method",
    "ci_level",
    "min_pairs",
    "scenarios",
    "test_seeds",
    "rows",
    "comparisons",
    "honesty"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 200
    },
    "schema_version": {
      "$ref": "#/$defs/schema_version"
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "recipe": {
      "$ref": "#/$defs/slug"
    },
    "engine": {
      "$ref": "des-trace.schema.json#/$defs/engine"
    },
    "mode": {
      "const": "traffic"
    },
    "variate_profile": {
      "const": "engine"
    },
    "primary_metric": {
      "const": "production_t_per_h"
    },
    "ci_method": {
      "const": "paired-t"
    },
    "ci_level": {
      "const": 0.95
    },
    "min_pairs": {
      "const": 30
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fleet_size",
          "bundle_sha256"
        ],
        "properties": {
          "fleet_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 400
          },
          "bundle_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      },
      "minItems": 1,
      "maxItems": 64
    },
    "test_seeds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/seed"
      },
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/row"
      },
      "minItems": 1,
      "maxItems": 20000
    },
    "comparisons": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/comparison"
      },
      "maxItems": 512
    },
    "honesty": {
      "$ref": "des-trace.schema.json#/$defs/honesty"
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_version": {
      "type": "string",
      "maxLength": 8,
      "pattern": "^1\\.[0-9]{1,4}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "dispatcher": {
      "enum": [
        "fixed",
        "nearest",
        "sptf",
        "sq",
        "lp",
        "ppo",
        "attention"
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "dispatcher",
        "fleet_size",
        "production_t_per_h",
        "queue_time_mean_min",
        "loader_utilisation_frac",
        "match_factor",
        "truck_hours_per_kt",
        "loader_hours_per_kt"
      ],
      "properties": {
        "seed": {
          "$ref": "#/$defs/seed"
        },
        "dispatcher": {
          "$ref": "#/$defs/dispatcher"
        },
        "fleet_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400
        },
        "production_t_per_h": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000.0
        },
        "queue_time_mean_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 10080
        },
        "loader_utilisation_frac": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "match_factor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "truck_hours_per_kt": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000.0
        },
        "loader_hours_per_kt": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000.0
        }
      }
    },
    "ci95": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "low_t_per_h",
        "high_t_per_h"
      ],
      "properties": {
        "low_t_per_h": {
          "type": "number",
          "minimum": -1000000.0,
          "maximum": 1000000.0
        },
        "high_t_per_h": {
          "type": "number",
          "minimum": -1000000.0,
          "maximum": 1000000.0
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learned",
        "baseline",
        "fleet_size",
        "n_pairs",
        "differences",
        "mean_diff_t_per_h",
        "sd_diff_t_per_h",
        "t_crit",
        "ci95",
        "verdict"
      ],
      "properties": {
        "learned": {
          "enum": [
            "ppo",
            "attention"
          ]
        },
        "baseline": {
          "enum": [
            "fixed",
            "nearest",
            "sptf",
            "sq",
            "lp",
            "ppo"
          ]
        },
        "fleet_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 400
        },
        "n_pairs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "differences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seed",
              "diff_t_per_h"
            ],
            "properties": {
              "seed": {
                "$ref": "#/$defs/seed"
              },
              "diff_t_per_h": {
                "type": "number",
                "minimum": -1000000.0,
                "maximum": 1000000.0
              }
            }
          },
          "maxItems": 1000
        },
        "mean_diff_t_per_h": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -1000000.0,
              "maximum": 1000000.0
            },
            {
              "type": "null"
            }
          ]
        },
        "sd_diff_t_per_h": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000.0
            },
            {
              "type": "null"
            }
          ]
        },
        "t_crit": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "ci95": {
          "anyOf": [
            {
              "$ref": "#/$defs/ci95"
            },
            {
              "type": "null"
            }
          ]
        },
        "verdict": {
          "enum": [
            "learned-better",
            "baseline-better",
            "no-significant-difference",
            "insufficient-evidence"
          ]
        },
        "reason": {
          "enum": [
            "fewer-than-30-pairs",
            "seed-sets-differ",
            "non-finite-difference"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "n_pairs": {
                "maximum": 29
              }
            },
            "required": [
              "n_pairs"
            ]
          },
          "then": {
            "properties": {
              "verdict": {
                "const": "insufficient-evidence"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "insufficient-evidence"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          },
          "else": {
            "not": {
              "required": [
                "reason"
              ]
            },
            "properties": {
              "ci95": {
                "$ref": "#/$defs/ci95"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "learned-better"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "properties": {
              "ci95": {
                "properties": {
                  "low_t_per_h": {
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "baseline-better"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "properties": {
              "ci95": {
                "properties": {
                  "high_t_per_h": {
                    "exclusiveMaximum": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "no-significant-difference"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "properties": {
              "ci95": {
                "properties": {
                  "low_t_per_h": {
                    "maximum": 0
                  },
                  "high_t_per_h": {
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}

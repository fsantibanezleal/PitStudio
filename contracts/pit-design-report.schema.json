{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/pit-design-report.schema.json",
  "title": "Pit design report",
  "description": "Per-bench table, ramp and windrow measures, cut/fill volumes and identity residual written by st20_pit_design (DC-004-05, spec 004-scene-pipeline).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "provenance",
    "label",
    "terrain_grid_sha256",
    "parameters",
    "outline",
    "benches",
    "ramp",
    "windrows",
    "volumes"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 200
    },
    "schema_version": {
      "$ref": "#/$defs/schema_version"
    },
    "kind": {
      "const": "pit-design-report"
    },
    "provenance": {
      "const": "design-code"
    },
    "label": {
      "const": "regenerated by design code, not observed"
    },
    "terrain_grid_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bench_height_m",
        "face_angle_deg",
        "berm_width_m",
        "ramp_grade_pct",
        "ramp_width_m",
        "windrow_height_m"
      ],
      "properties": {
        "bench_height_m": {
          "type": "number",
          "minimum": 5,
          "maximum": 30
        },
        "face_angle_deg": {
          "type": "number",
          "minimum": 40,
          "maximum": 85
        },
        "berm_width_m": {
          "type": "number",
          "minimum": 3,
          "maximum": 60
        },
        "ramp_grade_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 15
        },
        "ramp_width_m": {
          "type": "number",
          "minimum": 8,
          "maximum": 60
        },
        "windrow_height_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5
        }
      },
      "description": "declared design parameters (hard domain of FR-004-22)"
    },
    "outline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "vertices",
        "area_m2",
        "perimeter_m",
        "rim_z_m",
        "floor_z_m"
      ],
      "properties": {
        "source": {
          "enum": [
            "rim-contour",
            "upstream-shell"
          ]
        },
        "shell_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "vertices": {
          "type": "integer",
          "minimum": 3,
          "maximum": 100000
        },
        "area_m2": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 40000000000
        },
        "perimeter_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "rim_z_m": {
          "type": "number",
          "description": "site-frame elevation, m (FR-004-02: |offset| <= 5.0e3 m vertically)",
          "minimum": -5000,
          "maximum": 5000
        },
        "floor_z_m": {
          "type": "number",
          "description": "site-frame elevation, m (FR-004-02: |offset| <= 5.0e3 m vertically)",
          "minimum": -5000,
          "maximum": 5000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "upstream-shell"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "shell_sha256"
            ]
          },
          "else": {
            "not": {
              "required": [
                "shell_sha256"
              ]
            }
          }
        }
      ]
    },
    "benches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bench"
      },
      "minItems": 1,
      "maxItems": 512
    },
    "ramp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length_m",
        "max_grade_pct",
        "min_width_m",
        "sample_spacing_m",
        "connected"
      ],
      "properties": {
        "length_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "max_grade_pct": {
          "type": "number",
          "description": "measured on the centreline sampled at <= 1 m",
          "minimum": 0,
          "maximum": 100
        },
        "min_width_m": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "sample_spacing_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "connected": {
          "const": true,
          "description": "the centreline is one connected polyline (FR-004-17)"
        }
      }
    },
    "windrows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "height_m",
        "mid_axle_height_m",
        "governing_asset"
      ],
      "properties": {
        "height_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5
        },
        "mid_axle_height_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5
        },
        "governing_asset": {
          "$ref": "#/$defs/slug"
        }
      },
      "description": "windrow height and the mid-axle height of the largest haul unit (FR-004-18)"
    },
    "volumes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cut_m3",
        "fill_m3",
        "carved_sum_m3",
        "cell_area_m2",
        "identity_residual_rel"
      ],
      "properties": {
        "cut_m3": {
          "type": "number",
          "minimum": 0
        },
        "fill_m3": {
          "type": "number",
          "minimum": 0
        },
        "carved_sum_m3": {
          "type": "number",
          "description": "sum over cells of (z_terrain - z_final) x cell area (P-004-07)"
        },
        "cell_area_m2": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "identity_residual_rel": {
          "type": "number",
          "description": "|V_cut - V_fill - carved_sum| / max(V_cut, V_fill, 1 m^3)",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_version": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^1\\.[0-9]+$"
    },
    "bench": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "crest_z_m",
        "toe_z_m",
        "height_m",
        "face_angle_deg",
        "berm_width_m",
        "crest_perimeter_m",
        "widened_for_ramp"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        "crest_z_m": {
          "type": "number",
          "description": "site-frame elevation, m (FR-004-02: |offset| <= 5.0e3 m vertically)",
          "minimum": -5000,
          "maximum": 5000
        },
        "toe_z_m": {
          "type": "number",
          "description": "site-frame elevation, m (FR-004-02: |offset| <= 5.0e3 m vertically)",
          "minimum": -5000,
          "maximum": 5000
        },
        "height_m": {
          "type": "number",
          "description": "measured bench height",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "face_angle_deg": {
          "type": "number",
          "description": "measured face angle",
          "exclusiveMinimum": 0,
          "maximum": 90
        },
        "berm_width_m": {
          "type": [
            "number",
            "null"
          ],
          "description": "measured berm width; null for the floor bench",
          "minimum": 0,
          "maximum": 1000
        },
        "crest_perimeter_m": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "widened_for_ramp": {
          "type": "boolean"
        }
      },
      "description": "measured geometry of one bench (FR-004-19); tolerance checks belong to FR-004-35"
    }
  }
}

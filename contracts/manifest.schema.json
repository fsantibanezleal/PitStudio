{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fsantibanezleal.github.io/PitStudio/contracts/manifest.schema.json",
  "title": "PitStudio manifest",
  "description": "Run manifests, published run manifests and the web artefact index (DC-001-01, spec 001-contracts).",
  "oneOf": [
    {
      "$ref": "#/$defs/run"
    },
    {
      "$ref": "#/$defs/web_index"
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "tool_id": {
      "type": "string",
      "maxLength": 48,
      "pattern": "^[a-z][a-z0-9-]{1,47}$"
    },
    "artefact_id": {
      "type": "string",
      "maxLength": 96,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "run_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]{0,47}$"
    },
    "variant": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "sha256": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_sha": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "utc_timestamp": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,6})?Z$"
    },
    "date": {
      "type": "string",
      "maxLength": 10,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "release_tag": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^assets-v[0-9]+\\.[0-9]{2}\\.[0-9]{3}$"
    },
    "relpath": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?(/[A-Za-z0-9_]([A-Za-z0-9._-]{0,98}[A-Za-z0-9_])?){0,15}$"
    },
    "semver": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "package": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$"
    },
    "python_version": {
      "type": "string",
      "maxLength": 10,
      "pattern": "^3\\.[0-9]{1,2}(\\.[0-9]{1,3})?$"
    },
    "driver": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[0-9]+(\\.[0-9]+)+$"
    },
    "param_key": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "case_id": {
      "enum": [
        "A1",
        "A2",
        "A3",
        "B1",
        "B2",
        "C1",
        "C2",
        "C3",
        "D1",
        "D2",
        "E1",
        "E2"
      ]
    },
    "licence_class": {
      "enum": [
        "public-domain",
        "open-no-attribution",
        "own",
        "attribution",
        "share-alike",
        "display-only",
        "reference-only"
      ]
    },
    "spdx_id": {
      "enum": [
        "LicenseRef-USGov-PD",
        "CC0-1.0",
        "DL-DE-ZERO-2.0",
        "CC-BY-4.0",
        "LicenseRef-Copernicus-CLMS",
        "CC-BY-SA-3.0",
        "CC-BY-SA-4.0",
        "Apache-2.0",
        "MIT",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "MPL-2.0",
        "LGPL-2.1-or-later",
        "LicenseRef-TOST-1.0",
        "LicenseRef-NVIDIA-Open-Model",
        "LicenseRef-NVIDIA-SLA",
        "LicenseRef-NvidiaProprietary",
        "LicenseRef-NVIDIA-Omniverse",
        "LicenseRef-TensorRT-SLA",
        "LicenseRef-TensorRT-RTX-SLA"
      ]
    },
    "artefact_kind": {
      "enum": [
        "video",
        "image",
        "figure",
        "point-cloud",
        "mesh",
        "tiles",
        "splat",
        "onnx",
        "table",
        "trace",
        "shard",
        "field",
        "text",
        "model-card",
        "telemetry",
        "usd"
      ]
    },
    "stage_id": {
      "enum": [
        "s00_download",
        "s05_synthesize",
        "s10_preprocess",
        "s20_feature_extraction",
        "s30_train",
        "s40_infer",
        "s50_evaluate",
        "s60_export",
        "s62_accel",
        "s64_bench",
        "st10_terrain",
        "st20_pit_design",
        "st30_assets",
        "st40_compose",
        "st45_validate",
        "st45b_kit_validate",
        "st50_physics",
        "st52_rtx_render",
        "st53_sensors",
        "st54_vehicles",
        "st55_sdg",
        "st56_encode",
        "st57_rain_lidar",
        "st58_kit_capture",
        "st58b_capture_splat",
        "st59_reason_bench",
        "st59a_vqa",
        "st59b_plausibility",
        "st59c_captions",
        "st60_il_train",
        "st61_il_mpm_eval"
      ]
    },
    "local_only": {
      "const": "measured locally, not published (licence)"
    },
    "environment": {
      "enum": [
        "studio",
        "isaac",
        "rtx",
        "isaaclab",
        "kit",
        "reason",
        "pipeline",
        "accel",
        "external"
      ]
    },
    "schema_version": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^1\\.[0-9]+$"
    },
    "param_value_0": {
      "description": "a scalar parameter value (non-finite numbers are rejected by the loader)",
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ],
      "maxLength": 1024
    },
    "param_value_1": {
      "description": "a parameter value with at most 1 further level(s) of nesting",
      "anyOf": [
        {
          "$ref": "#/$defs/param_value_0"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/param_value_0"
          },
          "maxItems": 1024
        },
        {
          "type": "object",
          "propertyNames": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/param_value_0"
          },
          "maxProperties": 64
        }
      ]
    },
    "param_value_2": {
      "description": "a parameter value with at most 2 further level(s) of nesting",
      "anyOf": [
        {
          "$ref": "#/$defs/param_value_0"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/param_value_1"
          },
          "maxItems": 1024
        },
        {
          "type": "object",
          "propertyNames": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/param_value_1"
          },
          "maxProperties": 64
        }
      ]
    },
    "param_value_3": {
      "description": "a parameter value with at most 3 further level(s) of nesting",
      "anyOf": [
        {
          "$ref": "#/$defs/param_value_0"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/param_value_2"
          },
          "maxItems": 1024
        },
        {
          "type": "object",
          "propertyNames": {
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/param_value_2"
          },
          "maxProperties": 64
        }
      ]
    },
    "params": {
      "type": "object",
      "description": "effective parameters; nesting depth <= 4 including this object",
      "propertyNames": {
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/param_value_3"
      },
      "maxProperties": 64
    },
    "stage_key": {
      "type": "object",
      "description": "stage id plus optional variant",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stage_id"
        },
        "variant": {
          "$ref": "#/$defs/variant"
        }
      }
    },
    "input_ref": {
      "type": "object",
      "description": "a source id, an artefact id of the same run, or a minephys knowledge-table row id",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/artefact_id"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "kind": {
          "enum": [
            "source",
            "artefact",
            "knowledge"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "source",
                  "knowledge"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "$ref": "#/$defs/slug"
              }
            }
          }
        }
      ]
    },
    "output_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "bytes"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/relpath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "gpu": {
      "type": "object",
      "description": "GPU record (data-model §2.2); null for CPU-only runs",
      "additionalProperties": false,
      "required": [
        "backend",
        "index",
        "name",
        "driver",
        "vram_total_bytes",
        "power_limit_enforced_w"
      ],
      "properties": {
        "backend": {
          "enum": [
            "nvml",
            "fake"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "driver": {
          "$ref": "#/$defs/driver"
        },
        "vram_total_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "power_limit_enforced_w": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "env_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "python",
        "lock_sha256",
        "versions"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/environment"
        },
        "python": {
          "anyOf": [
            {
              "$ref": "#/$defs/python_version"
            },
            {
              "type": "null"
            }
          ]
        },
        "lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "versions": {
          "type": "object",
          "description": "package -> version as read from the lock",
          "propertyNames": {
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/version"
          },
          "maxProperties": 64
        }
      }
    },
    "error_class": {
      "enum": [
        "oom",
        "timeout",
        "warmup-timeout",
        "invalid-output",
        "invalid-result",
        "nonzero-exit",
        "guard",
        "lock-timeout",
        "lock-not-held",
        "cancelled",
        "interrupted",
        "hold",
        "unknown",
        null
      ]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n",
        "error_class"
      ],
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "error_class": {
          "$ref": "#/$defs/error_class"
        },
        "fallback": {
          "$ref": "#/$defs/params"
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "stage_determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "rerun_check"
      ],
      "properties": {
        "class": {
          "enum": [
            "bitwise",
            "statistical",
            "none"
          ]
        },
        "rerun_check": {
          "enum": [
            "pending",
            "pass",
            "fail",
            "not-applicable"
          ]
        },
        "max_deviation": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "telemetry_summary": {
      "type": "object",
      "description": "per-stage GPU telemetry summary (data-model §2.4); a null field is named in `unavailable`",
      "additionalProperties": false,
      "required": [
        "sample_hz",
        "n_samples",
        "gpu_busy_pct",
        "mem_used_peak_bytes",
        "power_w",
        "power_at_limit_frac",
        "energy_j",
        "sm_clock_mhz",
        "temp_c_max",
        "clocks_event_frac",
        "pcie_replays_delta"
      ],
      "properties": {
        "sample_hz": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 1,
              "maximum": 4
            },
            {
              "type": "null"
            }
          ]
        },
        "n_samples": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "gpu_busy_pct": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mean",
                "p50",
                "p95"
              ],
              "properties": {
                "mean": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "p50": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "p95": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "mem_used_peak_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "power_w": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mean",
                "p95",
                "max"
              ],
              "properties": {
                "mean": {
                  "type": "number",
                  "minimum": 0
                },
                "p95": {
                  "type": "number",
                  "minimum": 0
                },
                "max": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "power_at_limit_frac": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "energy_j": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "sm_clock_mhz": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mean",
                "p5"
              ],
              "properties": {
                "mean": {
                  "type": "number",
                  "minimum": 0
                },
                "p5": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "temp_c_max": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -100,
              "maximum": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "clocks_event_frac": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sw_power_cap",
                "sw_thermal",
                "hw_thermal",
                "hw_slowdown",
                "power_brake",
                "idle"
              ],
              "properties": {
                "sw_power_cap": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "sw_thermal": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "hw_thermal": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "hw_slowdown": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "power_brake": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "idle": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "nvenc_util_pct": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mean",
                "max"
              ],
              "properties": {
                "mean": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "max": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "pcie_replays_delta": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "unavailable": {
          "type": "object",
          "description": "field name -> reason it is null",
          "propertyNames": {
            "pattern": "^(sample_hz|n_samples|gpu_busy_pct|mem_used_peak_bytes|power_w|power_at_limit_frac|energy_j|sm_clock_mhz|temp_c_max|clocks_event_frac|nvenc_util_pct|pcie_replays_delta)$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "maxProperties": 12
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sample_hz": {
                "type": "null"
              }
            },
            "required": [
              "sample_hz"
            ]
          },
          "then": {
            "required": [
              "unavailable"
            ],
            "properties": {
              "unavailable": {
                "required": [
                  "sample_hz"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "n_samples": {
                "type": "null"
              }
            },
            "required": [
              "n_samples"
            ]
          },
          "then": {
            "required": [
              "unavailable"
            ],
            "properties": {
              "unavailable": {
                "required": [
                  "n_samples"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "gpu_busy_pct": {
                "type": "null"
              }
            },
            "required": [
              "gpu_busy_pct"
            ]
          },
          "then": {
            "required": [
              "unavailable"
            ],
            "properties": {
              "unavailable": {
                "required": [
                  "gpu_busy_pct"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mem_used_peak_bytes": {
                "type": "null"
              }
            },
            "required": [
              "mem_used_peak_bytes"
            ]
          },
          "then": {
            "required": [
              "unavailable"
            ],
            "properties": {
              "unavailable": {
                "required": [
                  "mem_used_peak_bytes"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "power_w": {
                "type": "null"
              }
            },
            "required": [
              "power_w"
            ]
          },
          "then": {
            "required": [
              "unavailable"
            ],
            "properties": {
              "unavailable": {
                "required": [
                  "power_w"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "power_at_limit_frac": {
                "type": "null"
              }
            },
            "required": [
              "power_at_limit_frac"
            ]
          },
          "then": {
            "required": [
              "unavailable"
            ],
            "properties": {
              "unavailable": {
                "required": [
                  "power_at_limit_frac"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "energy_j": {
                "type": "null"
              }
            },
            "required": [
              "energy_j"
            ]
          },
          "then": {
            "required": [
              "unavailable"
            ],
            "properties": {
              "unavailable": {
                "required": [
                  "energy_j"
                ]
              }
            }

            },
            "build_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "nvenc_api": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 16,
                  "pattern": "^[0-9]+\\.[0-9]+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 200
              },
              "maxItems": 64
            }
          }
        },
        "encode_fps": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "artefact": {
      "type": "object",
      "description": "artefact record (data-model §2.5); git host: `path` under web/public/; release host: the asset file name",
      "additionalProperties": false,
      "required": [
        "id",
        "run_id",
        "git_sha",
        "path",
        "bytes",
        "sha256",
        "kind",
        "producer",
        "inputs",
        "lane",
        "licence_class",
        "spdx",
        "asset_host",
        "budget_class"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/artefact_id"
        },
        "run_id": {
          "$ref": "#/$defs/run_id"
        },
        "git_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "path": {
          "$ref": "#/$defs/relpath"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-z]+/[a-z0-9.+-]{1,64}$"
        },
        "kind": {
          "$ref": "#/$defs/artefact_kind"
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool",
            "stage"
          ],
          "properties": {
            "tool": {
              "$ref": "#/$defs/tool_id"
            },
            "stage": {
              "$ref": "#/$defs/stage_key"
            }
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input_ref"
          },
          "maxItems": 32
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/case_id"
          },
          "maxItems": 12,
          "uniqueItems": true
        },
        "lane": {
          "enum": [
            "live",
            "replay",
            "static"
          ]
        },
        "lane_measurements": {
          "$ref": "#/$defs/lane_measurements"
        },
        "licence_class": {
          "$ref": "#/$defs/licence_class"
        },
        "spdx": {
          "$ref": "#/$defs/spdx_id"
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "asset_host": {
          "enum": [
            "git",
            "release"
          ]
        },
        "release_tag": {
          "$ref": "#/$defs/release_tag"
        },
        "budget_class": {
          "enum": [
            "videos",
            "tiles-glb",
            "shards-clouds",
            "splats",
            "onnx",
            "runtimes",
            "own-code",
            "studio-showcase"
          ]
        },
        "encoder": {
          "$ref": "#/$defs/encoder"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "asset_host": {
                "const": "release"
              }
            },
            "required": [
              "asset_host"
            ]
          },
          "then": {
            "required": [
              "release_tag"
            ],
            "properties": {
              "path": {
                "pattern": "^[^/]+$"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "release_tag"
              ]
            },
            "properties": {
              "bytes": {
                "maximum": 10485759
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "video"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "encoder"
            ]
          },
          "else": {
            "not": {
              "required": [
                "encoder"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "lane": {
                "const": "static"
              }
            },
            "required": [
              "lane"
            ]
          },
          "then": {
            "not": {
              "required": [
                "lane_measurements"
              ]
            },
            "properties": {
              "kind": {
                "enum": [
                  "image",
                  "figure",
                  "table",
                  "text",
                  "model-card",
                  "usd"
                ]
              }
            }
          },
          "else": {
            "required": [
              "lane_measurements"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "image",
                  "figure",
                  "table",
                  "text",
                  "model-card",
                  "usd"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "lane": {
                "const": "static"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "licence_class": {
                "enum": [
                  "public-domain",
                  "open-no-attribution",
                  "own"
                ]
              }
            },
            "required": [
              "licence_class"
            ]
          },
          "else": {
            "required": [
              "attribution"
            ]
          }
        }
      ]
    },
    "run": {
      "type": "object",
      "description": "run manifest (data-model §2.1)",
      "additionalProperties": false,
      "required": [
        "kind",
        "schema_version",
        "run_id",
        "recipe",
        "git_sha",
        "git_dirty",
        "runner_version",
        "created",
        "profile",
        "seed",
        "published",
        "launcher",
        "gpu",
        "stages",
        "artefacts"
      ],
      "properties": {
        "$schema": {
          "type": "string",
          "maxLength": 200,
          "description": "editor hint; ignored by consumers"
        },
        "kind": {
          "const": "run"
        },
        "schema_version": {
          "$ref": "#/$defs/schema_version"
        },
        "run_id": {
          "$ref": "#/$defs/run_id"
        },
        "recipe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "path",
            "sha256"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/slug"
            },
            "path": {
              "allOf": [
                {
                  "$ref": "#/$defs/relpath"
                },
                {
                  "pattern": "^(cases|_bench)/[^/]+\\.yaml$"
                }
              ],
              "description": "relative to studio/recipes/"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "git_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "git_dirty": {
          "type": "boolean"
        },
        "runner_version": {
          "$ref": "#/$defs/semver"
        },
        "created": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "profile": {
          "$ref": "#/$defs/slug"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "published": {
          "type": "boolean"
        },
        "launcher": {
          "enum": [
            "uv",
            "test"
          ]
        },
        "gpu": {
          "anyOf": [
            {
              "$ref": "#/$defs/gpu"
            },
            {
              "type": "null"
            }
          ]
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stage"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "artefacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artefact"
          },
          "maxItems": 2000
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "maxItems": 20
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "published": {
                "const": true
              }
            },
            "required": [
              "published"
            ]
          },
          "then": {
            "properties": {
              "git_dirty": {
                "const": false
              },
              "launcher": {
                "const": "uv"
              },
              "gpu": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "properties": {
                      "backend": {
                        "const": "nvml"
                      }
                    }
                  }
                ]
              },
              "stages": {
                "items": {
                  "if": {
                    "properties": {
                      "performance": {
                        "const": "local-only"
                      }
                    },
                    "required": [
                      "performance"
                    ]
                  },
                  "then": {
                    "properties": {
                      "telemetry": {
                        "$ref": "#/$defs/local_only"
                      },
                      "attempts": {
                        "items": {
                          "not": {
                            "required": [
                              "duration_s"
                            ]
                          }
                        }
                      }
                    },
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "wall_s"
                          ]
                        },
                        {
                          "required": [
                            "throughput"
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },

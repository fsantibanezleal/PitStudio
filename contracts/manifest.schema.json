        "status": {
          "enum": [
            "succeeded",
            "failed",
            "skipped",
            "cancelled",
            "blocked",
            "held",
            "interrupted",
            "env-disabled",
            "not_run"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "error_class": {
          "$ref": "#/$defs/error_class"
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attempt"
          },
          "minItems": 1,
          "maxItems": 5
        },
        "params": {
          "$ref": "#/$defs/params"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "shards": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "done"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "done": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          }
        },
        "determinism": {
          "$ref": "#/$defs/stage_determinism"
        },
        "performance": {
          "enum": [
            "public",
            "local-only"
          ]
        },
        "wall_s": {
          "type": "number",
          "minimum": 0
        },
        "telemetry": {
          "anyOf": [
            {
              "$ref": "#/$defs/telemetry_summary"
            },
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/local_only"
            }
          ]
        },
        "throughput": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit"
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          }
        },
        "thermal_flag": {
          "type": "boolean"
        },
        "log_tail": {
          "type": "string",
          "maxLength": 4000
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input_ref"
          },
          "maxItems": 32
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/output_file"
          },
          "maxItems": 64
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "succeeded",
                  "skipped",
                  "not_run"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "error_class": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "error_class": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_run"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ],
            "properties": {
              "outputs": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "reason"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "not_run",
                  "skipped"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "log_tail"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          }
        }
      ]
    },

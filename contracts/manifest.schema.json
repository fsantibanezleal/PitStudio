      ],
      "properties": {
        "codec": {
          "enum": [
            "av1",
            "h264"
          ]
        },
        "profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "pix_fmt": {
          "type": "string",
          "maxLength": 16,
          "pattern": "^[a-z0-9]{2,16}$"
        },
        "width": {
          "type": "integer",
          "minimum": 16,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 16,
          "maximum": 8192
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 240
        },
        "frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bitrate_kbps": {
          "type": "number",
          "exclusiveMinimum": 0
